{
  "schema": 1,
  "default_backend": "cpu",
  "target_backends": [
    {
      "name": "truega",
      "kind": "fpga",
      "targets": [
        "trueos",
        "zkvm"
      ],
      "cargo_feature": "truega",
      "exclusive_with": [
        "host-runtime"
      ],
      "parallelism": "single_fpga_offload_worker",
      "threading_contract": "async_msi_wake",
      "function_contract": "typed_ahead_of_time_fpga_function",
      "notes": [
        "TRUEOS owns BAR transport, MSI completion, callbacks, and model I/O.",
        "The backend never blocks a synchronous tensor callback or interprets FPGA firmware."
      ]
    },
    {
      "name": "cpu",
      "kind": "cpu",
      "cargo_feature": "host-runtime",
      "targets": [
        "*"
      ],
      "parallelism": "host_runtime",
      "threading_contract": "host_threads_or_library_default"
    },
    {
      "name": "cuda",
      "kind": "gpu",
      "cargo_feature": "cuda",
      "parallelism": "cuda_runtime"
    }
  ]
}
