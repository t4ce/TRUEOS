diff --git a/tools/cloudbuild/web/styles.css b/tools/cloudbuild/web/styles.css
new file mode 100644
index 0000000000000000000000000000000000000000..cec9c1a2b235b1a3a97b0f064c7a4db9e271127f
--- /dev/null
+++ b/tools/cloudbuild/web/styles.css
@@ -0,0 +1,288 @@
+@charset "UTF-8";
+
+:root {
+  --bg: #101112;
+  --panel: #17181a;
+  --panel-raised: #1c1d20;
+  --line: #303135;
+  --line-soft: #252629;
+  --text: #eeefec;
+  --muted: #a0a19f;
+  --dim: #747772;
+  --accent: #f28d5b;
+  --accent-bright: #ff9e6d;
+  --accent-faint: #f28d5b12;
+  --success: #9ecda9;
+  --danger: #f0a09c;
+  --mono: ui-monospace, "SFMono-Regular", Consolas, "Liberation Mono", monospace;
+}
+
+* { box-sizing: border-box; }
+html { scroll-behavior: smooth; scroll-padding-top: 24px; }
+body { margin: 0; color: var(--text); background: var(--bg); font-family: Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; font-size: 14px; line-height: 1.5; -webkit-font-smoothing: antialiased; }
+body::before { content: ""; position: absolute; inset: 0 0 auto; height: 560px; background: radial-gradient(ellipse at 80% 15%, #b96a3b0b, transparent 55%); pointer-events: none; z-index: -1; }
+button, input, textarea { font: inherit; }
+button, a, input, textarea, summary { -webkit-tap-highlight-color: transparent; }
+button { cursor: pointer; }
+button:disabled { cursor: not-allowed; }
+a { color: inherit; text-decoration: none; }
+a:hover { color: var(--accent-bright); }
+button, a, input, textarea, summary { outline-offset: 4px; }
+:focus-visible { outline: 2px solid var(--accent); }
+fieldset { min-width: 0; border: 0; margin: 0; padding: 0; }
+h1, h2, h3, p, pre, dl, dd { margin: 0; }
+button svg, a svg { flex-shrink: 0; }
+[hidden] { display: none !important; }
+.shell { width: min(1240px, calc(100% - 88px)); margin-inline: auto; }
+.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
+.skip-link { position: fixed; top: 12px; left: 12px; transform: translateY(-180%); z-index: 10; background: var(--accent); color: #20150e; padding: 12px 18px; border-radius: 4px; }
+.skip-link:focus { transform: none; }
+
+.site-header { min-height: 88px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--line-soft); gap: 24px; }
+.brand { display: inline-flex; align-items: center; gap: 12px; font-size: 17px; font-weight: 760; letter-spacing: -.6px; white-space: nowrap; }
+.brand:hover { color: var(--text); }
+.brand-symbol { width: 23px; height: 23px; display: grid; grid-template-columns: 1fr 1fr; gap: 3px; transform: rotate(-1deg); }
+.brand-symbol i { background: var(--accent); }
+.brand-symbol i:last-child { opacity: .4; }
+.brand-divider { color: #555752; font-weight: 400; margin: 0 15px; }
