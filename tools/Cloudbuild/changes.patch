+                "buildins": self.plan["buildins"], "sources": "0" * 64,
+                "packages": dict.fromkeys(self.plan["buildins"], "0" * 64),
+                "database": {"app.db": "0" * 64, "app.db.lz4": "0" * 64},
+                "generated": generated,
