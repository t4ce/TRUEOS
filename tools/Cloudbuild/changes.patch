+    def test_request_rejects_unknown_fields_and_nonboolean_selections(self):
+        invalid = [
+            [], None, True, {"preset": []}, {"preset": "unknown"}, {"profile": "debug"},
+            {"profile": []}, {"features": []}, {"features": {"unknown": True}},
