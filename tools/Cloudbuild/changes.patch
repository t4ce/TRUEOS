+        self.assertEqual(calls[0][:5], ["cargo", "rustc", "--bin", "TRUEOS", "--release"])
+        self.assertNotIn("buildin-apps", ",".join(calls[0]))
+        self.assertFalse((self.directory / "TRUEOS-Buildins").exists())
