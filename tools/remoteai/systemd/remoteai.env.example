# Copy to ~/.config/remoteai/remoteai.env and chmod 600.
REMOTEAI_BIND=192.168.178.111:3042
REMOTEAI_BEARER_TOKEN=REPLACE_WITH_A_LONG_RANDOM_SHARED_SECRET
REMOTEAI_MODEL=auto
REMOTEAI_REQUEST_TIMEOUT_SECONDS=24
# REMOTEAI_COPILOT_HOME=/absolute/path/to/private/remoteai/copilot-state
# Optional: prefer the logged-in `gh` user. Set this only for headless hosts
# where `gh auth status` is unavailable.
# COPILOT_GITHUB_TOKEN=github_token_kept_only_on_the_linux_host
