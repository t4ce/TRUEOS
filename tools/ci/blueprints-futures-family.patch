+    // The futures facade and futures-util publish in lockstep. Downgrading only
+    // the patched futures-util package can be impossible when a freshly
+    // resolved facade requires its own newer patch release (for example,
+    // futures 0.3.34 requires futures-util ^0.3.34). Align the facade first so
+    // Cargo can then select TRUEOS's vendored futures-util implementation.
+    if mismatch.name == "futures-util" {
+        let lock_path = generated_lock_path(staged_manifest)?;
+        if let Some(futures) = lock_packages(&lock_path)?.into_iter().find(|package| {
+            package.name == "futures"
+                && package.version != mismatch.overlay_version
+                && cargo_semver_same_line(&package.version, &mismatch.overlay_version)
+        }) {
+            let facade_mismatch = LockMismatch {
+                name: futures.name,
+                locked_version: futures.version,
+                overlay_version: mismatch.overlay_version.clone(),
+            };
+            run_staged_lock_overlay_update(
+                staged_manifest,
+                staged_source_overlay,
+                &facade_mismatch,
+            )?;
+        }
+    }
