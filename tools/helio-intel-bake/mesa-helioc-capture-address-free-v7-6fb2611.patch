index b8f512080e25..000000000000 100644
--- a/src/intel/vulkan/anv_descriptor_set.c
+++ b/src/intel/vulkan/anv_descriptor_set.c
@@ -162,5 +162,207 @@ anv_trueos_helioc_dump_v5_indirect_template(
    fclose(file);
 }
+
+/* V7 records are deliberately narrower than a package.  They capture the
+ * exact gfx120 buffer and descriptor-buffer SURFACE_STATE encodings for the
+ * four explicitly named HelioC sets, but never preserve an ANV VA, pool
+ * offset, or allocation identity.  The descriptor layout is expressed only
+ * relative to the sealed descriptor-payload object so a later normalizer can
+ * build a broker-owned indirect window without recovering a capture address. */
+static atomic_uint trueos_helioc_v7_sequence = 0;
+
+static bool
+anv_trueos_helioc_v7_set_contract(const struct anv_descriptor_set *set,
+                                  const char *set_role)
+{
+   static const VkDescriptorType compute_types[] = {
+      VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER, VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE,
+      VK_DESCRIPTOR_TYPE_SAMPLER, VK_DESCRIPTOR_TYPE_STORAGE_IMAGE,
+   };
+   static const VkDescriptorType graphics_types[] = {
+      VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER, VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE,
+      VK_DESCRIPTOR_TYPE_SAMPLER,
+   };
+   const VkDescriptorType *types;
+   uint32_t count;
+
+   if (set == NULL || set_role == NULL || set->is_push || set->layout == NULL ||
+       set->layout->type != ANV_PIPELINE_DESCRIPTOR_SET_LAYOUT_TYPE_INDIRECT ||
+       set->desc_surface_mem.alloc_size == 0 || set->desc_surface_state.map == NULL ||
+       set->desc_surface_state.alloc_size != ANV_SURFACE_STATE_SIZE ||
+       set->desc_surface_mem.alloc_size < set->layout->descriptor_buffer_surface_size ||
+       set->desc_surface_addr.bo == NULL)
+      return false;
+
+   if (strcmp(set_role, "compute_ping_a") == 0 ||
+       strcmp(set_role, "compute_ping_b") == 0) {
+      types = compute_types;
+      count = ARRAY_SIZE(compute_types);
+   } else if (strcmp(set_role, "graphics_a") == 0 ||
+              strcmp(set_role, "graphics_b") == 0) {
+      types = graphics_types;
+      count = ARRAY_SIZE(graphics_types);
+   } else {
+      return false;
+   }
+
+   if (set->layout->binding_count != count)
+      return false;
+   for (uint32_t b = 0; b < count; b++) {
+      const struct anv_descriptor_set_binding_layout *layout = &set->layout->binding[b];
+      if (layout->type != types[b] || layout->array_size != 1 ||
+          layout->descriptor_surface_offset > set->desc_surface_mem.alloc_size ||
+          layout->descriptor_surface_stride >
+             set->desc_surface_mem.alloc_size - layout->descriptor_surface_offset)
+         return false;
+   }
+   return true;
+}
+
+static bool
+anv_trueos_helioc_v7_descriptor_layout(const struct anv_descriptor_set *set,
+                                       char *out, size_t out_size)
+{
+   size_t used = 0;
+   for (uint32_t b = 0; b < set->layout->binding_count; b++) {
+      const struct anv_descriptor_set_binding_layout *layout = &set->layout->binding[b];
+      const int written = snprintf(
+         out + used, out_size - used, "%s%u:%u:%u:%u:%u",
+         b == 0 ? "" : ",", b, layout->descriptor_surface_offset,
+         layout->descriptor_surface_stride, layout->descriptor_sampler_offset,
+         layout->descriptor_sampler_stride);
+      if (written < 0 || (size_t)written >= out_size - used)
+         return false;
+      used += written;
+   }
+   return used != 0;
+}
+
+static const char *
+anv_trueos_helioc_v7_buffer_role(const struct anv_descriptor_set *set,
+                                 const char *set_role,
+                                 const struct anv_buffer *buffer,
+                                 VkDescriptorType type, uint32_t binding,
+                                 uint32_t element, VkDeviceSize offset,
+                                 VkDeviceSize range)
+{
+   if (set_role == NULL)
+      return NULL;
+   if (buffer == NULL || buffer->vk.base.object_name == NULL ||
+       strcmp(buffer->vk.base.object_name, "trueos.helioc.params_arena") != 0 ||
+       type != VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER || binding != 0 || element != 0)
+      return NULL;
+   if ((strcmp(set_role, "compute_ping_a") == 0 ||
+        strcmp(set_role, "compute_ping_b") == 0) && offset == 0 && range == 112)
+      return "sim_params";
+   if ((strcmp(set_role, "graphics_a") == 0 ||
+        strcmp(set_role, "graphics_b") == 0) && offset == 128 && range == 272)
+      return "render_params";
+   return NULL;
+}
+
+static void
+anv_trueos_helioc_dump_v7_template(const struct anv_device *device,
+                                   const struct anv_descriptor_set *set,
+                                   const char *set_role, const char *object,
+                                   const char *kind, const char *resource_role,
+                                   uint32_t binding, uint64_t resource_offset,
+                                   uint64_t resource_bytes,
+                                   const struct anv_state *state,
+                                   struct anv_address expected_address,
+                                   const char *reloc_kind,
+                                   const char *reloc_source)
+{
+   const char *dir = os_get_option("TRUEOS_HELIOC_ANV_DUMP_DIR");
+   if (dir == NULL || !anv_trueos_helioc_v7_set_contract(set, set_role) ||
+       object == NULL || kind == NULL || resource_role == NULL || state == NULL ||
+       state->map == NULL || state->alloc_size != ANV_SURFACE_STATE_SIZE ||
+       (state->offset & (ANV_SURFACE_STATE_SIZE - 1)) != 0 ||
+       expected_address.bo == NULL || resource_bytes == 0 || reloc_kind == NULL ||
+       reloc_source == NULL || device->info->verx10 != 120 ||
+       device->isl_dev.ss.size != ANV_SURFACE_STATE_SIZE)
+      return;
+
+   const uint8_t addr_offset = device->isl_dev.ss.addr_offset;
+   if (addr_offset + sizeof(uint64_t) > ANV_SURFACE_STATE_SIZE)
+      return;
+   uint64_t packed_address;
+   memcpy(&packed_address, (const uint8_t *)state->map + addr_offset,
+          sizeof(packed_address));
+   if (packed_address != anv_address_physical(expected_address))
+      return;
+
+   char descriptor_layout[256];
+   if (!anv_trueos_helioc_v7_descriptor_layout(set, descriptor_layout,
+                                               sizeof(descriptor_layout)))
+      return;
+   uint8_t normalized[ANV_SURFACE_STATE_SIZE];
+   memcpy(normalized, state->map, sizeof(normalized));
+   memset(normalized + addr_offset, 0, sizeof(uint64_t));
+
+   const unsigned sequence = atomic_fetch_add(&trueos_helioc_v7_sequence, 1);
+   char path[4096];
+   if (snprintf(path, sizeof(path), "%s/helioc-anv-v7-surface-%08u.txt", dir,
+                sequence) >= (int)sizeof(path))
+      return;
+   FILE *file = fopen(path, "wb");
+   if (file == NULL)
+      return;
+   fprintf(file,
+           "TRUEOS_HELIOC_SURFACE_TEMPLATE_V7\nobject=%s\nkind=%s\n"
+           "resource_role=%s\nset_role=%s\nbinding=%u\nstate_bytes=%u\n"
+           "state_alignment=%u\ndescriptor_payload_offset=0\n"
+           "descriptor_bytes=%u\nsampler_bytes=%u\ndescriptor_layout=%s\n"
+           "resource_offset=%llu\nresource_bytes=%llu\ndata_hex=",
+           object, kind, resource_role, set_role, binding,
+           ANV_SURFACE_STATE_SIZE, ANV_SURFACE_STATE_SIZE,
+           set->layout->descriptor_buffer_surface_size,
+           set->layout->descriptor_buffer_sampler_size, descriptor_layout,
+           (unsigned long long)resource_offset,
+           (unsigned long long)resource_bytes);
+   for (uint32_t i = 0; i < sizeof(normalized); i++)
+      fprintf(file, "%02x", normalized[i]);
+   fprintf(file, "\nreloc=%u,8,%s,%s,0,0xffffffffffffffff,0\n",
+           addr_offset, reloc_kind, reloc_source);
+   fclose(file);
+}
+
+static void
+anv_trueos_helioc_dump_v7_buffer_surface(const struct anv_device *device,
+                                         const struct anv_descriptor_set *set,
+                                         const char *set_role,
+                                         const char *resource_role,
+                                         uint32_t binding, VkDeviceSize offset,
+                                         VkDeviceSize range,
+                                         const struct anv_buffer_view *view)
+{
+   char object[128];
+   if (view == NULL || resource_role == NULL ||
+       snprintf(object, sizeof(object), "buffer_surface_%s_%s", resource_role,
+                set_role) >= (int)sizeof(object))
+      return;
+   anv_trueos_helioc_dump_v7_template(
+      device, set, set_role, object, "buffer_surface", resource_role, binding,
+      offset, range, &view->general.state, view->address, "fixed_gpu", resource_role);
+}
+
+static void
+anv_trueos_helioc_dump_v7_descriptor_set_surface(
+   const struct anv_device *device, const struct anv_descriptor_set *set,
+   const char *set_role)
+{
+   char object[128];
+   char payload[128];
+   if (snprintf(object, sizeof(object), "descriptor_set_surface_%s", set_role) >=
+          (int)sizeof(object) ||
+       snprintf(payload, sizeof(payload), "descriptor_payload_%s", set_role) >=
+          (int)sizeof(payload))
+      return;
+   anv_trueos_helioc_dump_v7_template(
+      device, set, set_role, object, "descriptor_set_surface", payload,
+      UINT32_MAX, 0, set->layout->descriptor_buffer_surface_size,
+      &set->desc_surface_state, set->desc_surface_addr, "object_gpu", payload);
+}
+
 static void
 anv_trueos_helioc_dump_descriptor_state(uint32_t kind, VkDescriptorType type,
                                         uint32_t binding, uint32_t element,
@@ -2526,7 +2728,15 @@ anv_descriptor_set_write_buffer(struct anv_device *device,
           */
          bview->general.state = ANV_STATE_NULL;
       } else {
          anv_descriptor_write_surface_state(device, desc, bview->general.state);
+        const char *set_role = anv_trueos_helioc_descriptor_set_role(set);
+        const char *resource_role = anv_trueos_helioc_v7_buffer_role(
+           set, set_role, buffer, type, binding, element, offset, range);
+        if (resource_role != NULL) {
+           anv_trueos_helioc_dump_v7_buffer_surface(
+              device, set, set_role, resource_role, binding, offset, range, bview);
+           anv_trueos_helioc_dump_v7_descriptor_set_surface(device, set, set_role);
+        }
       }
    }
