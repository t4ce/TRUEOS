diff --git a/src/intel/tools/intel_noop_drm_shim.c b/src/intel/tools/intel_noop_drm_shim.c
index 195bdad..f4e7b5b 100644
--- a/src/intel/tools/intel_noop_drm_shim.c
+++ b/src/intel/tools/intel_noop_drm_shim.c
@@ -221,6 +221,10 @@ i915_ioctl_get_param(int fd, unsigned long request, void *arg)
    case I915_PARAM_CHIPSET_ID:
       *gp->value = i915.device_id;
       return 0;
    case I915_PARAM_REVISION:
-      *gp->value = 0;
+      /* KMD revision is distinct from the PCI revision exposed in sysfs. */
+      const char *kmd_revision = os_get_option("TRUEOS_HELIOC_STUB_KMD_REVISION");
+      *gp->value = kmd_revision ? strtol(kmd_revision, NULL, 0) : 0;
+      if (*gp->value < 0 || *gp->value > UINT16_MAX)
+         return -EINVAL;
       return 0;
@@ -602,10 +607,10 @@ drm_shim_driver_init(void)
    /* This is capture-only identity injection.  A no-op DRM shim can exercise
     * compiler/state emission but cannot prove physical-device retirement. */
-   const char *revision = os_get_option("TRUEOS_HELIOC_STUB_REVISION");
-   if (revision == NULL)
-      revision = "0x0";
+   const char *pci_revision = os_get_option("TRUEOS_HELIOC_STUB_PCI_REVISION");
+   if (pci_revision == NULL)
+      pci_revision = "0x0";
    char revision_content[16];
-   snprintf(revision_content, sizeof(revision_content), "%s\n", revision);
+   snprintf(revision_content, sizeof(revision_content), "%s\n", pci_revision);
    drm_shim_override_file(revision_content,
                           "/sys/dev/char/%d:%d/device/revision",
                           DRM_MAJOR, render_node_minor);
