+/* V11A captures only the final Gfx12.0 compute IDD, after Mesa has packed
+ * the live binding/sampler offsets and before it owns the dynamic allocation.
+ * It is intentionally not a command or graphics-state capture. */
+static atomic_uint trueos_helioc_v11a_sequence = 0;
+
+static const char *
+anv_trueos_helioc_v11a_compute_role(const struct anv_cmd_compute_state *comp_state)
+{
+   const struct anv_shader *shader = comp_state->shader;
+   const struct anv_descriptor_set *set = comp_state->base.descriptors[0];
+   const char *name;
+   const char *sampled_name;
+   const char *storage_name;
+   const struct anv_descriptor *params;
+   const struct anv_descriptor *sampled;
+   const struct anv_descriptor *sampler;
+   const struct anv_descriptor *storage;
+
+   if (shader == NULL || shader->vk.stage != MESA_SHADER_COMPUTE ||
+       set == NULL || set->base.object_name == NULL || set->is_push ||
+       set->layout == NULL ||
+       set->layout->type != ANV_PIPELINE_DESCRIPTOR_SET_LAYOUT_TYPE_INDIRECT ||
+       set->layout->binding_count != 4 || set->descriptor_count != 4 ||
+       set->desc_surface_mem.map == NULL || set->desc_surface_mem.alloc_size != 64 ||
+       shader->bind_map.surface_count != 4 || shader->bind_map.sampler_count != 1)
+      return NULL;
+
+   name = set->base.object_name;
+   if (strcmp(name, "trueos.helioc.compute_ping_a") == 0) {
+      sampled_name = "trueos.helioc.volume_b";
+      storage_name = "trueos.helioc.volume_a";
+   } else if (strcmp(name, "trueos.helioc.compute_ping_b") == 0) {
+      sampled_name = "trueos.helioc.volume_a";
+      storage_name = "trueos.helioc.volume_b";
+   } else {
+      return NULL;
+   }
+
+   params = &set->descriptors[0];
+   sampled = &set->descriptors[1];
+   sampler = &set->descriptors[2];
+   storage = &set->descriptors[3];
+   if (params->type != VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER || params->buffer == NULL ||
+       params->buffer->vk.base.object_name == NULL ||
+       strcmp(params->buffer->vk.base.object_name, "trueos.helioc.params_arena") != 0 ||
+       params->offset != 0 || params->range != 112 || params->bind_range != 112 ||
+       sampled->type != VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE || sampled->image_view == NULL ||
+       sampled->sampler != NULL || sampled->image_view->image == NULL ||
+       sampled->image_view->image->vk.base.object_name == NULL ||
+       strcmp(sampled->image_view->image->vk.base.object_name, sampled_name) != 0 ||
+       sampler->type != VK_DESCRIPTOR_TYPE_SAMPLER || sampler->image_view != NULL ||
+       sampler->sampler == NULL || storage->type != VK_DESCRIPTOR_TYPE_STORAGE_IMAGE ||
+       storage->image_view == NULL || storage->sampler != NULL ||
+       storage->image_view->image == NULL ||
+       storage->image_view->image->vk.base.object_name == NULL ||
+       strcmp(storage->image_view->image->vk.base.object_name, storage_name) != 0)
+      return NULL;
+
+   static const VkDescriptorType types[] = {
+      VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER, VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE,
+      VK_DESCRIPTOR_TYPE_SAMPLER, VK_DESCRIPTOR_TYPE_STORAGE_IMAGE,
+   };
+   static const uint32_t offsets[] = { 0, 16, 24, 32 };
+   static const uint32_t strides[] = { 16, 8, 8, 32 };
+   for (uint32_t binding = 0; binding < 4; binding++) {
+      const struct anv_descriptor_set_binding_layout *layout = &set->layout->binding[binding];
+      if (layout->type != types[binding] || layout->array_size != 1 ||
+          layout->descriptor_index != binding ||
+          layout->descriptor_surface_offset != offsets[binding] ||
+          layout->descriptor_surface_stride != strides[binding])
+         return NULL;
+   }
+   for (uint32_t pass = 0; pass < 2; pass++) {
+      const uint32_t count = pass == 0 ? shader->bind_map.surface_count :
+                                         shader->bind_map.sampler_count;
+      const struct anv_pipeline_binding *bindings =
+         pass == 0 ? shader->bind_map.surface_to_descriptor :
+                     shader->bind_map.sampler_to_descriptor;
+      for (uint32_t i = 0; i < count; i++) {
+         const struct anv_pipeline_binding *binding = &bindings[i];
+         const struct anv_descriptor_set *candidate = NULL;
+         if (binding->set == ANV_DESCRIPTOR_SET_DESCRIPTORS) {
+            if (binding->index >= MAX_SETS)
+               return NULL;
+            candidate = comp_state->base.descriptors[binding->index];
+         } else if (binding->set < MAX_SETS) {
+            candidate = comp_state->base.descriptors[binding->set];
+         }
+         if (candidate != set)
+            return NULL;
+      }
+   }
+
+   return name + strlen("trueos.helioc.");
+}
+
+static bool
+anv_trueos_helioc_v11a_step_one(const struct anv_cmd_buffer *cmd_buffer)
+{
+   const char *name = cmd_buffer->vk.base.object_name;
+   return name != NULL &&
+      (strcmp(name, "trueos.helioc.command.current_a.step1.final_b.dispatch_a_to_b") == 0 ||
+       strcmp(name, "trueos.helioc.command.current_b.step1.final_a.dispatch_b_to_a") == 0);
+}
+
+static void
+anv_trueos_helioc_dump_v11a_compute_idd(struct anv_cmd_buffer *cmd_buffer,
+                                         const struct anv_cmd_compute_state *comp_state,
+                                         const uint32_t *packed,
+                                         const uint32_t *pipeline)
+{
+   const struct anv_trueos_helioc_v10a_slice *slice = &cmd_buffer->trueos_helioc_v10a;
+   const struct anv_shader *shader = comp_state->shader;
+   const struct brw_cs_prog_data *prog_data;
+   const char *role;
+   const char *dir;
+   uint32_t idd[GENX(INTERFACE_DESCRIPTOR_DATA_length)];
+   uint64_t expected_ksp, live_ksp;
+   uint32_t program_offset, sampler_count, expected_word6;
+   struct intel_cs_dispatch_info dispatch;
+
+   if (!slice->active || slice->invalid || slice->owner != cmd_buffer ||
+       slice->batch != &cmd_buffer->batch || slice->batch_start != cmd_buffer->batch.start ||
+       slice->dispatch_count != 1 || !anv_trueos_helioc_v11a_step_one(cmd_buffer) ||
+       shader == NULL || shader->code == NULL || shader->prog_data == NULL ||
+       shader->prog_data->program_size == 0 || (shader->prog_data->program_size & 3) ||
+       (role = anv_trueos_helioc_v11a_compute_role(comp_state)) == NULL)
+      return;
+
+   prog_data = get_cs_prog_data(comp_state);
+   dispatch = brw_cs_get_dispatch_info(cmd_buffer->device->info, prog_data, NULL);
+   program_offset = brw_cs_prog_data_prog_offset(prog_data, dispatch.simd_size);
+   if (program_offset > INT32_MAX || (program_offset & 63) ||
+       prog_data->base.total_scratch != 0 || prog_data->push.per_thread.regs > UINT16_MAX ||
+       prog_data->push.cross_thread.regs > UINT8_MAX)
+      return;
+   expected_ksp = (uint64_t)shader->kernel.offset + program_offset;
+   if (expected_ksp > UINT64_C(0x0000ffffffffffc0) || (expected_ksp & 63))
+      return;
+   sampler_count = cmd_buffer->device->physical->instance->force_sampler_prefetch ?
+      MIN2((shader->bind_map.sampler_count + 3) / 4, 4) : 0;
+   expected_word6 = dispatch.threads |
+      (intel_compute_slm_encode_size(GFX_VER, prog_data->base.total_shared) << 16) |
+      (prog_data->uses_barrier ? (UINT32_C(1) << 21) : 0);
+
+   for (uint32_t i = 0; i < GENX(INTERFACE_DESCRIPTOR_DATA_length); i++) {
+      if (packed[i] & pipeline[i])
+         return;
+      idd[i] = packed[i] | pipeline[i];
+   }
+   live_ksp = (uint64_t)idd[0] | ((uint64_t)(idd[1] & 0xffff) << 32);
+   if (live_ksp != expected_ksp || (idd[1] & 0xffff0000) ||
+       idd[2] != (UINT32_C(1) << 20) ||
+       (idd[3] & 0xffffffe0) != cmd_buffer->state.samplers[MESA_SHADER_COMPUTE].offset ||
+       (idd[3] & 0x1f) != ((sampler_count & 7) << 2) ||
+       (idd[4] & 0x0000ffe0) != cmd_buffer->state.binding_tables[MESA_SHADER_COMPUTE].offset ||
+       (idd[4] & 0xffff001f) != MIN2(shader->bind_map.surface_count, 31) ||
+       (idd[5] & 0xffff) != 0 || (idd[5] >> 16) != prog_data->push.per_thread.regs ||
+       idd[6] != expected_word6 ||
+       (idd[7] & 0xffffff00) || (idd[7] & 0xff) != prog_data->push.cross_thread.regs)
+      return;
+
+   idd[0] = 0;
+   idd[1] &= 0xffff0000;
+   idd[3] &= ~UINT32_C(0xffffffe0);
+   idd[4] &= ~UINT32_C(0x0000ffe0);
+   if (idd[0] || idd[1] || idd[3] & UINT32_C(0xffffffe0) ||
+       idd[4] & UINT32_C(0x0000ffe0))
+      return;
+
+   dir = os_get_option("TRUEOS_HELIOC_ANV_DUMP_DIR");
+   if (dir == NULL)
+      return;
+   const unsigned sequence = atomic_fetch_add(&trueos_helioc_v11a_sequence, 1);
+   char path[4096];
+   if (snprintf(path, sizeof(path), "%s/helioc-anv-v11a-compute-idd-%08u.txt", dir,
+                sequence) >= (int)sizeof(path))
+      return;
+   FILE *file = fopen(path, "wb");
+   if (file == NULL)
+      return;
+   blake3_hash code_hash, idd_hash;
+   char code_hex[BLAKE3_HEX_LEN], idd_hex[BLAKE3_HEX_LEN];
+   _mesa_blake3_compute(shader->code, shader->prog_data->program_size, code_hash);
+   _mesa_blake3_compute(idd, sizeof(idd), idd_hash);
+   _mesa_blake3_format(code_hex, code_hash);
+   _mesa_blake3_format(idd_hex, idd_hash);
+   fprintf(file, "TRUEOS_HELIOC_COMPUTE_IDD_V11A\nset_role=%s\nstage=%u\n"
+                 "program_bytes=%u\nprogram_blake3=%s\nsource_hash=0x%08x\n"
+                 "bytes=%zu\ndata_blake3=%s\ndata_hex=",
+           role, (uint32_t)shader->vk.stage, shader->prog_data->program_size, code_hex,
+           prog_data->base.source_hash, sizeof(idd), idd_hex);
+   for (uint32_t i = 0; i < sizeof(idd); i++)
+      fprintf(file, "%02x", ((const uint8_t *)idd)[i]);
+   fprintf(file, "\nreloc=0,8,fixed_gpu,shader_heap,0,0000ffffffffffc0,%u\n"
+                 "reloc=12,4,object_offset,sampler_state,0,ffffffe0,0\n"
+                 "reloc=16,4,object_offset,binding_table_%s,0,0000ffe0,0\n",
+           program_offset, role);
+   fclose(file);
+}
