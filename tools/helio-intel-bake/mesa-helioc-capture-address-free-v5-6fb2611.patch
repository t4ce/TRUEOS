 }
+
+/* Address-free template evidence for the shader-loaded indirect payloads.
+ * The output deliberately contains neither the descriptor-pool VA nor an
+ * image/sampler VA: each packed field has its semantic source and exact
+ * HELIOCRS positioning rule.  A later broker normalizer selects fixed object
+ * locations and performs the masked RMW itself. */
+static void
+anv_trueos_helioc_dump_v5_indirect_template(
+   const struct anv_descriptor_set *set, const struct anv_image_view *image_view,
+   uint32_t binding, const char *kind, const void *data, uint32_t bytes)
+{
+   const char *dir = os_get_option("TRUEOS_HELIOC_ANV_DUMP_DIR");
+   const char *set_role = anv_trueos_helioc_descriptor_set_role(set);
+   const char *resource_role = anv_trueos_helioc_descriptor_image_role(image_view);
+   if (dir == NULL || set_role == NULL || resource_role == NULL || kind == NULL ||
+       data == NULL || (bytes != 8 && bytes != 32))
+      return;
+   uint8_t normalized[32];
+   memcpy(normalized, data, bytes);
+   if (strcmp(kind, "sampled") == 0) {
+      memset(normalized, 0, 8);
+   } else if (strcmp(kind, "storage") == 0) {
+      memset(normalized, 0, 4);
+      memset(normalized + offsetof(struct anv_storage_image_descriptor, image_address), 0, 8);
+   } else {
+      return;
+   }
+   const unsigned sequence = atomic_fetch_add(&trueos_helioc_descriptor_sequence, 1);
+   char path[4096];
+   if (snprintf(path, sizeof(path), "%s/helioc-anv-v5-indirect-%08u.txt", dir, sequence) >=
+       (int)sizeof(path))
+      return;
+   FILE *file = fopen(path, "wb");
+   if (file == NULL)
+      return;
+   fprintf(file,
+           "TRUEOS_HELIOC_INDIRECT_TEMPLATE_V5\nset_role=%s\nresource_role=%s\n"
+           "kind=%s\nbinding=%u\nbytes=%u\ndata_hex=",
+           set_role, resource_role, kind, binding, bytes);
+   for (uint32_t i = 0; i < bytes; i++)
+      fprintf(file, "%02x", normalized[i]);
+   if (strcmp(kind, "sampled") == 0) {
+      fprintf(file,
+              "\nreloc=0,4,object_offset,surface_%s_sampled,0,0xffffffc0,0"
+              "\nreloc=4,4,object_offset,sampler_state,0,0xffffffff,0\n",
+              resource_role);
+   } else {
+      fprintf(file,
+              "\nreloc=0,4,object_offset,surface_%s_storage,0,0xffffffc0,0"
+              "\nreloc=8,8,fixed_gpu,%s,0,0xffffffffffffffff,0\n",
+              resource_role, resource_role);
+   }
+   fclose(file);
+}
 static void
 anv_trueos_helioc_dump_descriptor_state(uint32_t kind, VkDescriptorType type,
