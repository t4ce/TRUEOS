 }
 
+void genX(anv_trueos_helioc_v10a_begin_dispatch)(struct anv_cmd_buffer *cmd_buffer,
+                                                   uint32_t base_x, uint32_t base_y,
+                                                   uint32_t base_z, uint32_t groups_x,
+                                                   uint32_t groups_y, uint32_t groups_z);
+void genX(anv_trueos_helioc_v10a_begin_draw)(struct anv_cmd_buffer *cmd_buffer,
+                                              uint32_t vertex_count,
+                                              uint32_t instance_count,
