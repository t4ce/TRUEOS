+void genX(anv_trueos_helioc_v10a_end_draw)(struct anv_cmd_buffer *cmd_buffer);
+
+/* V10A brackets only the named application workload between its first
+ * dispatch (or the step-zero draw) and the direct fullscreen draw.  It is
+ * intentionally raw diagnostic evidence; package construction must reject it.
+ */
+static void
+genX(anv_trueos_helioc_v10a_reset)(struct anv_cmd_buffer *cmd_buffer)
+{
+   cmd_buffer->trueos_helioc_v10a = (struct anv_trueos_helioc_v10a_slice) { 0 };
+}
+
+static bool
+genX(anv_trueos_helioc_v10a_valid_entry)(const struct anv_cmd_buffer *cmd_buffer,
+                                          const struct anv_trueos_helioc_command_catalog *entry)
+{
+   return entry != NULL && entry == anv_trueos_helioc_command_catalog_entry(cmd_buffer) &&
+          cmd_buffer->batch.start != NULL && cmd_buffer->batch.next != NULL &&
+          (const uint8_t *)cmd_buffer->batch.next >= (const uint8_t *)cmd_buffer->batch.start &&
+          (((uintptr_t)cmd_buffer->batch.start | (uintptr_t)cmd_buffer->batch.next) & 3) == 0;
+}
+
+static void
+genX(anv_trueos_helioc_v10a_begin)(struct anv_cmd_buffer *cmd_buffer,
+                                    const struct anv_trueos_helioc_command_catalog *entry)
+{
+   genX(anv_trueos_helioc_v10a_reset)(cmd_buffer);
+   cmd_buffer->trueos_helioc_v10a.owner = cmd_buffer;
+   cmd_buffer->trueos_helioc_v10a.batch = &cmd_buffer->batch;
+   cmd_buffer->trueos_helioc_v10a.batch_start = cmd_buffer->batch.start;
+   cmd_buffer->trueos_helioc_v10a.start = cmd_buffer->batch.next;
+   cmd_buffer->trueos_helioc_v10a.active = true;
+   if (!genX(anv_trueos_helioc_v10a_valid_entry)(cmd_buffer, entry))
+      cmd_buffer->trueos_helioc_v10a.invalid = true;
+}
+
+void
+genX(anv_trueos_helioc_v10a_begin_dispatch)(struct anv_cmd_buffer *cmd_buffer,
+                                             uint32_t base_x, uint32_t base_y,
+                                             uint32_t base_z, uint32_t groups_x,
+                                             uint32_t groups_y, uint32_t groups_z)
+{
+   const struct anv_trueos_helioc_command_catalog *entry =
+      anv_trueos_helioc_command_catalog_entry(cmd_buffer);
+   if (entry == NULL)
+      return;
+
+   if (!cmd_buffer->trueos_helioc_v10a.active) {
+      if (entry->step == 0)
+         return;
+      genX(anv_trueos_helioc_v10a_begin)(cmd_buffer, entry);
+   }
+
+   if (!genX(anv_trueos_helioc_v10a_valid_entry)(cmd_buffer, entry) ||
+       cmd_buffer->trueos_helioc_v10a.owner != cmd_buffer ||
+       cmd_buffer->trueos_helioc_v10a.batch != &cmd_buffer->batch ||
+       cmd_buffer->trueos_helioc_v10a.batch_start != cmd_buffer->batch.start ||
+       entry->step == 0 || base_x != 0 || base_y != 0 || base_z != 0 ||
+       groups_x != 24 || groups_y != 12 || groups_z != 24 ||
+       cmd_buffer->trueos_helioc_v10a.dispatch_count >= entry->step) {
+      cmd_buffer->trueos_helioc_v10a.invalid = true;
+      return;
+   }
+   cmd_buffer->trueos_helioc_v10a.dispatch_count++;
+}
+
+void
+genX(anv_trueos_helioc_v10a_begin_draw)(struct anv_cmd_buffer *cmd_buffer,
+                                         uint32_t vertex_count,
+                                         uint32_t instance_count,
+                                         uint32_t first_vertex,
+                                         uint32_t first_instance)
+{
+   const struct anv_trueos_helioc_command_catalog *entry =
+      anv_trueos_helioc_command_catalog_entry(cmd_buffer);
+   if (entry == NULL)
+      return;
+
+   if (entry->step == 0 && !cmd_buffer->trueos_helioc_v10a.active)
+      genX(anv_trueos_helioc_v10a_begin)(cmd_buffer, entry);
+
+   if (!cmd_buffer->trueos_helioc_v10a.active)
+      return;
+   if (!genX(anv_trueos_helioc_v10a_valid_entry)(cmd_buffer, entry) ||
+       cmd_buffer->trueos_helioc_v10a.owner != cmd_buffer ||
+       cmd_buffer->trueos_helioc_v10a.batch != &cmd_buffer->batch ||
+       cmd_buffer->trueos_helioc_v10a.batch_start != cmd_buffer->batch.start ||
+       vertex_count != 3 || instance_count != 1 || first_vertex != 0 ||
+       first_instance != 0 ||
+       cmd_buffer->trueos_helioc_v10a.dispatch_count != entry->step)
+      cmd_buffer->trueos_helioc_v10a.invalid = true;
+}
+
+static bool
+genX(anv_trueos_helioc_v10a_contains_bbe)(const void *start, const void *end)
+{
+   const uint8_t *bytes = start;
+   const uint8_t *limit = end;
+   for (; bytes < limit; bytes += sizeof(uint32_t)) {
+      uint32_t dword;
+      memcpy(&dword, bytes, sizeof(dword));
+      if (dword == 0x05000000)
+         return true;
+   }
+   return false;
+}
+
+void
+genX(anv_trueos_helioc_v10a_end_draw)(struct anv_cmd_buffer *cmd_buffer)
+{
+   const struct anv_trueos_helioc_command_catalog *entry =
+      anv_trueos_helioc_command_catalog_entry(cmd_buffer);
+   struct anv_trueos_helioc_v10a_slice *slice = &cmd_buffer->trueos_helioc_v10a;
+   if (!slice->active)
+      return;
+
+   const uint8_t *start = slice->start;
+   const uint8_t *end = cmd_buffer->batch.next;
+   const uint32_t bytes = end >= start ? (uint32_t)(end - start) : 0;
+   const char *dir = os_get_option("TRUEOS_HELIOC_ANV_DUMP_DIR");
+   if (entry == NULL || anv_batch_has_error(&cmd_buffer->batch) ||
+       !genX(anv_trueos_helioc_v10a_valid_entry)(cmd_buffer, entry) ||
+       slice->invalid || slice->owner != cmd_buffer || slice->batch != &cmd_buffer->batch ||
+       slice->batch_start != cmd_buffer->batch.start || slice->dispatch_count != entry->step ||
+       bytes == 0 || bytes > 256 * 1024 || (bytes & 3) ||
+       genX(anv_trueos_helioc_v10a_contains_bbe)(start, end) || dir == NULL) {
+      genX(anv_trueos_helioc_v10a_reset)(cmd_buffer);
+      return;
+   }
+
+   const struct anv_address start_addr = anv_batch_address(&cmd_buffer->batch, (void *)start);
+   const uint64_t raw_va = anv_address_physical(start_addr);
+   if (start_addr.bo == NULL || raw_va == 0) {
+      genX(anv_trueos_helioc_v10a_reset)(cmd_buffer);
+      return;
+   }
+   const unsigned sequence = atomic_fetch_add(&trueos_helioc_v2_sequence, 1);
+   char path[4096];
+   if (snprintf(path, sizeof(path), "%s/helioc-anv-v10a-slice-%08u.txt", dir, sequence) >=
+       (int)sizeof(path)) {
+      genX(anv_trueos_helioc_v10a_reset)(cmd_buffer);
+      return;
+   }
+   FILE *file = fopen(path, "wb");
+   if (file != NULL) {
+      fprintf(file,
+              "TRUEOS_HELIOC_WORKLOAD_SLICE_V10A\ncurrent=%s\nstep=%u\nfinal_role=%s\n"
+              "dispatch_roles=%s\ndraw_vertices=3\nraw_va=0x%llx\nbytes=%u\ndata_hex=",
+              entry->current, entry->step, entry->final_role, entry->dispatch_roles,
+              (unsigned long long)raw_va, bytes);
+      for (uint32_t i = 0; i < bytes; i++)
+         fprintf(file, "%02x", start[i]);
+      fputc('\n', file);
+      fclose(file);
+   }
+   genX(anv_trueos_helioc_v10a_reset)(cmd_buffer);
+}
