index b284a7f..fc228f6 100644
--- a/src/intel/vulkan/anv_image_view.c
+++ b/src/intel/vulkan/anv_image_view.c
@@ -4,6 +4,108 @@
 
 #include "anv_private.h"
 
+#include <stdatomic.h>
+#include <stdio.h>
+
+#include "util/u_debug.h"
+
+/* Emit address-free ISL surface-state templates for the narrowly named
+ * HelioC images.  This deliberately sits after isl_surf_fill_state(): it
+ * records the bytes ANV really packed for gfx120 and proves that the one
+ * normalized address field was the image address that entered ISL. */
+static atomic_uint trueos_helioc_surface_sequence = 0;
+
+static const char *
+anv_trueos_helioc_surface_resource_role(const struct anv_image *image)
+{
+   const char *name = image->vk.base.object_name;
+   if (name == NULL)
+      return NULL;
+   if (strcmp(name, "trueos.helioc.volume_a") == 0)
+      return "volume_a";
+   if (strcmp(name, "trueos.helioc.volume_b") == 0)
+      return "volume_b";
+   if (strcmp(name, "trueos.helioc.output_target") == 0)
+      return "ui4";
+   return NULL;
+}
+
+static const char *
+anv_trueos_helioc_surface_kind(const char *role,
+                               isl_surf_usage_flags_t usage,
+                               enum anv_image_view_state_flags flags)
+{
+   if ((usage & ISL_SURF_USAGE_TEXTURE_BIT) && flags == 0 &&
+       (strcmp(role, "volume_a") == 0 || strcmp(role, "volume_b") == 0))
+      return "sampled";
+   if ((usage & ISL_SURF_USAGE_STORAGE_BIT) &&
+       (strcmp(role, "volume_a") == 0 || strcmp(role, "volume_b") == 0))
+      return "storage";
+   if ((usage & ISL_SURF_USAGE_RENDER_TARGET_BIT) && strcmp(role, "ui4") == 0)
+      return "target";
+   return NULL;
+}
+
+static void
+anv_trueos_helioc_dump_surface_template(const struct anv_device *device,
+                                        const struct anv_image *image,
+                                        isl_surf_usage_flags_t usage,
+                                        enum anv_image_view_state_flags flags,
+                                        const struct anv_surface_state *state)
+{
+   const char *dir = os_get_option("TRUEOS_HELIOC_ANV_DUMP_DIR");
+   const char *role = anv_trueos_helioc_surface_resource_role(image);
+   if (dir == NULL || role == NULL || device->info->verx10 != 120 ||
+       device->isl_dev.ss.size != ANV_SURFACE_STATE_SIZE)
+      return;
+   const char *kind = anv_trueos_helioc_surface_kind(role, usage, flags);
+   if (kind == NULL || state->state.alloc_size < ANV_SURFACE_STATE_SIZE)
+      return;
+
+   const uint8_t addr_offset = device->isl_dev.ss.addr_offset;
+   uint64_t packed_address;
+   memcpy(&packed_address, state->state_data.data + addr_offset, sizeof(packed_address));
+   if (packed_address != anv_address_physical(state->address))
+      return;
+
+   uint8_t normalized[ANV_SURFACE_STATE_SIZE];
+   memcpy(normalized, state->state_data.data, sizeof(normalized));
+   memset(normalized + addr_offset, 0, sizeof(uint64_t));
+   if (strcmp(kind, "target") == 0) {
+      /* gfx120 RENDER_SURFACE_STATE: DW2 width[13:0], height[29:16];
+       * DW3 pitch_bytes_minus_one[17:0].  Keep all other packed ISL bits. */
+      uint32_t *dw = (uint32_t *)normalized;
+      dw[2] &= ~(0x00003fffu | 0x3fff0000u);
+      dw[3] &= ~0x0003ffffu;
+   }
+
+   const unsigned sequence = atomic_fetch_add(&trueos_helioc_surface_sequence, 1);
+   char path[4096];
+   if (snprintf(path, sizeof(path), "%s/helioc-anv-v6-surface-%08u.txt", dir, sequence) >=
+       (int)sizeof(path))
+      return;
+   FILE *file = fopen(path, "wb");
+   if (file == NULL)
+      return;
+   fprintf(file, "TRUEOS_HELIOC_SURFACE_TEMPLATE_V6\nrole=%s\nkind=%s\n"
+           "bytes=%u\nstate_offset=%lld\ndata_hex=",
+           role, kind, ANV_SURFACE_STATE_SIZE, (long long)state->state.offset);
+   for (unsigned i = 0; i < sizeof(normalized); i++)
+      fprintf(file, "%02x", normalized[i]);
+   if (strcmp(kind, "target") == 0) {
+      fprintf(file,
+              "\nreloc=%u,8,runtime_gpu,ui4,0,0xffffffffffffffff,0"
+              "\nreloc=8,4,runtime_u32,width,0,0x00003fff,-1"
+              "\nreloc=8,4,runtime_u32,height,0,0x3fff0000,-1"
+              "\nreloc=12,4,runtime_u32,pitch,0,0x0003ffff,-1\n",
+              addr_offset);
+   } else {
+      fprintf(file, "\nreloc=%u,8,fixed_gpu,%s,0,0xffffffffffffffff,0\n",
+              addr_offset, role);
+   }
+   fclose(file);
+}
+
 static enum isl_channel_select
 remap_swizzle(VkComponentSwizzle swizzle,
               struct isl_swizzle format_swizzle)
@@ -156,6 +258,9 @@ anv_image_fill_surface_state(struct anv_device *device,
 
    if (state_inout->state.map)
       memcpy(state_inout->state.map, surface_state_map, ANV_SURFACE_STATE_SIZE);
+
+   anv_trueos_helioc_dump_surface_template(device, image, view_usage, flags,
+                                           state_inout);
 }
 
