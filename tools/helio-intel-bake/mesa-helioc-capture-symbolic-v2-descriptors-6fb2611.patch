diff --git a/src/intel/vulkan/anv_descriptor_set.c b/src/intel/vulkan/anv_descriptor_set.c
index ec4b3ca..0c61971 100644
--- a/src/intel/vulkan/anv_descriptor_set.c
+++ b/src/intel/vulkan/anv_descriptor_set.c
@@ -38,6 +38,74 @@
 /* Raw records contain virtual addresses and are capture evidence only.  One
  * per-record filename avoids interleaved append writes. */
 static atomic_uint trueos_helioc_descriptor_sequence = 0;
+
+/* The payloads below are the actual indirect descriptors read by the shader.
+ * They remain raw-address diagnostics: the capture never claims they are a
+ * relocatable package representation. */
+static const char *
+anv_trueos_helioc_descriptor_set_role(const struct anv_descriptor_set *set)
+{
+   const char *name = set->base.object_name;
+   if (name == NULL)
+      return NULL;
+   if (strcmp(name, "trueos.helioc.compute_ping_a") == 0)
+      return "compute_ping_a";
+   if (strcmp(name, "trueos.helioc.compute_ping_b") == 0)
+      return "compute_ping_b";
+   if (strcmp(name, "trueos.helioc.graphics") == 0)
+      return "graphics";
+   return NULL;
+}
+
+static const char *
+anv_trueos_helioc_descriptor_image_role(const struct anv_image_view *image_view)
+{
+   if (image_view == NULL || image_view->image == NULL)
+      return NULL;
+   const char *name = image_view->image->vk.base.object_name;
+   if (name == NULL)
+      return NULL;
+   if (strcmp(name, "trueos.helioc.volume_a") == 0)
+      return "volume_a";
+   if (strcmp(name, "trueos.helioc.volume_b") == 0)
+      return "volume_b";
+   return NULL;
+}
+
+static void
+anv_trueos_helioc_dump_indirect_descriptor(const struct anv_descriptor_set *set,
+                                           const struct anv_image_view *image_view,
+                                           uint32_t binding, uint64_t raw_va,
+                                           const char *kind,
+                                           const void *data, uint32_t bytes)
+{
+   const char *dir = os_get_option("TRUEOS_HELIOC_ANV_DUMP_DIR");
+   const char *set_role = anv_trueos_helioc_descriptor_set_role(set);
+   const char *resource_role = anv_trueos_helioc_descriptor_image_role(image_view);
+   if (dir == NULL || set_role == NULL || resource_role == NULL || kind == NULL ||
+       data == NULL || (bytes != 8 && bytes != 32))
+      return;
+
+   const unsigned sequence = atomic_fetch_add(&trueos_helioc_descriptor_sequence, 1);
+   char path[4096];
+   if (snprintf(path, sizeof(path), "%s/helioc-anv-v2-descriptor-%08u.txt", dir,
+                sequence) >= (int)sizeof(path))
+      return;
+   FILE *file = fopen(path, "wb");
+   if (file == NULL)
+      return;
+   fprintf(file,
+           "TRUEOS_HELIOC_INDIRECT_DESCRIPTOR_V2\n"
+           "set_role=%s\nresource_role=%s\nkind=%s\nbinding=%u\n"
+           "raw_va=0x%llx\nbytes=%u\ndata_hex=",
+           set_role, resource_role, kind, binding,
+           (unsigned long long)raw_va, bytes);
+   const uint8_t *raw = data;
+   for (uint32_t i = 0; i < bytes; i++)
+      fprintf(file, "%02x", raw[i]);
+   fputc('\n', file);
+   fclose(file);
+}
 static void
 anv_trueos_helioc_dump_descriptor_state(uint32_t kind, VkDescriptorType type,
                                         uint32_t binding, uint32_t element,
@@ -2090,6 +2158,14 @@ anv_descriptor_set_write_image_view(struct anv_device *device,
       assert(bind_layout->max_plane_count <= ARRAY_SIZE(desc_data));
       memcpy(desc_surface_map, desc_data,
              bind_layout->max_plane_count * sizeof(desc_data[0]));
+      if (image_view != NULL && bind_layout->max_plane_count == 1) {
+         const uint64_t raw_va = anv_address_physical(set->desc_surface_addr) +
+            bind_layout->descriptor_surface_offset +
+            element * bind_layout->descriptor_surface_stride;
+         anv_trueos_helioc_dump_indirect_descriptor(
+            set, image_view, binding, raw_va, "sampled", desc_data,
+            sizeof(desc_data[0]));
+      }
    }
 
    if (data & ANV_DESCRIPTOR_INDIRECT_STORAGE_IMAGE) {
@@ -2109,6 +2185,12 @@ anv_descriptor_set_write_image_view(struct anv_device *device,
             .format = image_view->planes[0].isl.format,
          };
          memcpy(desc_surface_map, &desc_data, sizeof(desc_data));
+         const uint64_t raw_va = anv_address_physical(set->desc_surface_addr) +
+            bind_layout->descriptor_surface_offset +
+            element * bind_layout->descriptor_surface_stride;
+         anv_trueos_helioc_dump_indirect_descriptor(
+            set, image_view, binding, raw_va, "storage", &desc_data,
+            sizeof(desc_data));
       } else {
          memset(desc_surface_map, 0, bind_layout->descriptor_surface_stride);
       }
