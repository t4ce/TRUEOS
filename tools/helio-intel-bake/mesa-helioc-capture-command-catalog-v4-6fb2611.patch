+   { "trueos.helioc.command.current_a.step1.final_b.dispatch_a_to_b", "volume_a", 1, "volume_b", "a_to_b", "none" },
+   { "trueos.helioc.command.current_a.step2.final_a.dispatch_a_to_b_b_to_a", "volume_a", 2, "volume_a", "a_to_b,b_to_a", "compute_write_to_compute_read" },
+   { "trueos.helioc.command.current_b.step0.final_b.dispatch_none", "volume_b", 0, "volume_b", "none", "none" },
+   { "trueos.helioc.command.current_b.step1.final_a.dispatch_b_to_a", "volume_b", 1, "volume_a", "b_to_a", "none" },
+   { "trueos.helioc.command.current_b.step2.final_b.dispatch_b_to_a_a_to_b", "volume_b", 2, "volume_b", "b_to_a,a_to_b", "compute_write_to_compute_read" },
+};
+
+static const struct anv_trueos_helioc_command_catalog *
+anv_trueos_helioc_command_catalog_entry(const struct anv_cmd_buffer *cmd_buffer)
+{
+   const char *name = cmd_buffer->vk.base.object_name;
+   if (name == NULL)
+      return NULL;
+   for (uint32_t i = 0; i < ARRAY_SIZE(trueos_helioc_command_catalog); i++) {
+      if (strcmp(name, trueos_helioc_command_catalog[i].name) == 0)
+         return &trueos_helioc_command_catalog[i];
+   }
+   return NULL;
+}
+
+/* State/table V2/V3 keeps one named anchor command.  This prevents a catalog
+ * run from silently coalescing incompatible repeated state while preserving
+ * the established exact-state parser contract. */
+static bool
+anv_trueos_helioc_is_state_anchor(const struct anv_cmd_buffer *cmd_buffer)
+{
+   const struct anv_trueos_helioc_command_catalog *entry =
+      anv_trueos_helioc_command_catalog_entry(cmd_buffer);
+   return entry != NULL && strcmp(entry->current, "volume_a") == 0 && entry->step == 2;
+}
+
+/* The two graphics descriptor sets are distinct semantic resources.  Tables
+ * are captured at their first explicitly-named use: A after both compute
+ * ping-pong steps, B in its no-dispatch draw variant. */
+static bool
+anv_trueos_helioc_is_table_anchor(const struct anv_cmd_buffer *cmd_buffer)
+{
+   const struct anv_trueos_helioc_command_catalog *entry =
+      anv_trueos_helioc_command_catalog_entry(cmd_buffer);
+   return entry != NULL &&
+      ((strcmp(entry->current, "volume_a") == 0 && entry->step == 2) ||
+       (strcmp(entry->current, "volume_b") == 0 && entry->step == 0));
+}
+
+static void
+anv_trueos_helioc_dump_v4_command(const struct anv_cmd_buffer *cmd_buffer,
+                                  uint64_t raw_va, const void *data, uint32_t bytes)
+{
+   const struct anv_trueos_helioc_command_catalog *entry =
+      anv_trueos_helioc_command_catalog_entry(cmd_buffer);
+   const char *dir = os_get_option("TRUEOS_HELIOC_ANV_DUMP_DIR");
+   if (entry == NULL || dir == NULL || raw_va == 0 || data == NULL || bytes == 0 || (bytes & 3))
+      return;
+   const unsigned sequence = atomic_fetch_add(&trueos_helioc_v2_sequence, 1);
+   char path[4096];
+   if (snprintf(path, sizeof(path), "%s/helioc-anv-v4-command-%08u.txt", dir, sequence) >=
+       (int)sizeof(path))
+      return;
+   FILE *file = fopen(path, "wb");
+   if (file == NULL)
+      return;
+   fprintf(file,
+           "TRUEOS_HELIOC_COMMAND_V4\ncurrent=%s\nstep=%u\nfinal_role=%s\n"
+           "dispatch_roles=%s\nvolume_layout=general_to_general\n"
+           "inter_dispatch_visibility=%s\ndraw_vertices=3\nraw_va=0x%llx\nbytes=%u\ndata_hex=",
+           entry->current, entry->step, entry->final_role, entry->dispatch_roles,
+           entry->inter_dispatch_visibility,
+           (unsigned long long)raw_va, bytes);
+   const uint8_t *raw = data;
+   for (uint32_t i = 0; i < bytes; i++)
+      fprintf(file, "%02x", raw[i]);
+   fputc('\n', file);
+   fclose(file);
+}
