 /* State bytes are emitted after descriptor lookup and BT address addition.
  * Per-record files avoid interleaved writes; the bytes remain non-relocatable. */
 static atomic_uint trueos_helioc_command_sequence = 0;
+static atomic_uint trueos_helioc_v2_sequence = 0;
+
+/* V2 is a capture manifest, not a relocation format.  Roles come only from
+ * exact, application-supplied debug names; a host pointer is never identity. */
+static const char *
+anv_trueos_helioc_role(const char *name)
+{
+   if (name == NULL)
+      return NULL;
+   if (strcmp(name, "trueos.helioc.volume_a") == 0)
+      return "volume_a";
+   if (strcmp(name, "trueos.helioc.volume_b") == 0)
+      return "volume_b";
+   if (strcmp(name, "trueos.helioc.sim_params") == 0)
+      return "sim_params";
+   if (strcmp(name, "trueos.helioc.render_params") == 0)
+      return "render_params";
+   if (strcmp(name, "trueos.helioc.output_target") == 0)
+      return "output_target";
+   return NULL;
+}
+
+static const char *
+anv_trueos_helioc_buffer_role(const struct anv_buffer *buffer,
+                              mesa_shader_stage stage, uint32_t binding)
+{
+   const char *name = buffer->vk.base.object_name;
+   if (name != NULL && strcmp(name, "trueos.helioc.params_arena") == 0) {
+      if (stage == MESA_SHADER_COMPUTE && binding == 0)
+         return "sim_params";
+      if (stage == MESA_SHADER_FRAGMENT && binding == 0)
+         return "render_params";
+   }
+   return anv_trueos_helioc_role(name);
+}
+
+static bool
+anv_trueos_helioc_desc_is_image(const struct anv_descriptor *desc)
+{
+   return desc->type == VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER ||
+          desc->type == VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE ||
+          desc->type == VK_DESCRIPTOR_TYPE_INPUT_ATTACHMENT ||
+          desc->type == VK_DESCRIPTOR_TYPE_STORAGE_IMAGE;
+}
+
+static bool
+anv_trueos_helioc_desc_is_buffer(const struct anv_descriptor *desc)
+{
+   return desc->type == VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER ||
+          desc->type == VK_DESCRIPTOR_TYPE_STORAGE_BUFFER ||
+          desc->type == VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER_DYNAMIC ||
+          desc->type == VK_DESCRIPTOR_TYPE_STORAGE_BUFFER_DYNAMIC;
+}
+
+static void
+anv_trueos_helioc_dump_v2(const char *role, const char *kind,
+                           mesa_shader_stage stage, uint32_t binding,
+                           uint64_t raw_va, uint64_t allocation_bytes,
+                           uint64_t logical_bytes, uint64_t resource_offset,
+                           uint64_t state_heap_va, uint64_t state_heap_bytes,
+                           uint64_t state_offset, uint64_t state_bytes,
+                           uint64_t row_pitch, uint64_t array_pitch,
+                           const void *state_data)
+{
+   const char *dir = os_get_option("TRUEOS_HELIOC_ANV_DUMP_DIR");
+   if (dir == NULL || role == NULL || kind == NULL || raw_va == 0 ||
+       allocation_bytes == 0 || logical_bytes == 0)
+      return;
+
+   const unsigned sequence = atomic_fetch_add(&trueos_helioc_v2_sequence, 1);
+   char path[4096];
+   if (snprintf(path, sizeof(path), "%s/helioc-anv-v2-%08u.txt", dir, sequence) >=
+       (int)sizeof(path))
+      return;
+   FILE *file = fopen(path, "wb");
+   if (file == NULL)
+      return;
+   fprintf(file,
+           "TRUEOS_HELIOC_RESOURCE_V2\n"
+           "role=%s\nkind=%s\nstage=%u\nbinding=%u\n"
+           "raw_va=0x%llx\nallocation_bytes=%llu\nlogical_bytes=%llu\n"
+           "resource_offset=%llu\nstate_heap_va=0x%llx\n"
+           "state_heap_bytes=%llu\nstate_offset=%llu\nstate_bytes=%llu\n"
+           "row_pitch=%llu\narray_pitch=%llu\nstate_hex=",
+           role, kind, (uint32_t)stage, binding,
+           (unsigned long long)raw_va, (unsigned long long)allocation_bytes,
+           (unsigned long long)logical_bytes, (unsigned long long)resource_offset,
+           (unsigned long long)state_heap_va, (unsigned long long)state_heap_bytes,
+           (unsigned long long)state_offset, (unsigned long long)state_bytes,
+           (unsigned long long)row_pitch, (unsigned long long)array_pitch);
+   if (state_data != NULL && state_bytes != 0 && state_bytes <= 64) {
+      const uint8_t *bytes = state_data;
+      for (uint32_t i = 0; i < state_bytes; i++)
+         fprintf(file, "%02x", bytes[i]);
+   } else {
+      fputs("-", file);
+   }
+   fputc('\n', file);
+   fclose(file);
+}
+
+static void
+anv_trueos_helioc_dump_v2_image(struct anv_cmd_buffer *cmd_buffer,
+                                const struct anv_image *image,
+                                mesa_shader_stage stage, uint32_t binding,
+                                uint64_t state_offset)
+{
+   const char *role = anv_trueos_helioc_role(image->vk.base.object_name);
+   const struct anv_image_binding *memory =
+      &image->bindings[ANV_IMAGE_MEMORY_BINDING_MAIN];
+   if (role == NULL || memory->address.bo == NULL || image->n_planes != 1)
+      return;
+   const struct isl_surf *surf = &image->planes[0].primary_surface.isl;
+   anv_trueos_helioc_dump_v2(
+      role, "image", stage, binding, anv_address_physical(memory->address),
+      memory->address.bo->size, surf->size_B, memory->memory_range.offset,
+      cmd_buffer->device->physical->va.internal_surface_state_pool.addr,
+      cmd_buffer->device->physical->va.internal_surface_state_pool.size,
+      state_offset, ANV_SURFACE_STATE_SIZE, surf->row_pitch_B,
+      surf->array_pitch_el_rows * surf->row_pitch_B, NULL);
+}
+
+static void
+anv_trueos_helioc_dump_v2_buffer(struct anv_cmd_buffer *cmd_buffer,
+                                 const struct anv_descriptor *desc,
+                                 mesa_shader_stage stage, uint32_t binding,
+                                 uint64_t state_offset)
+{
+   const struct anv_buffer *buffer = desc->buffer;
+   if (buffer == NULL || buffer->address.bo == NULL)
+      return;
+   const char *role = anv_trueos_helioc_buffer_role(buffer, stage, binding);
+   if (role == NULL || desc->range == VK_WHOLE_SIZE)
+      return;
+   anv_trueos_helioc_dump_v2(
+      role, "buffer", stage, binding,
+      anv_address_physical(buffer->address) + desc->offset,
+      buffer->address.bo->size, desc->range, desc->offset,
+      cmd_buffer->device->physical->va.internal_surface_state_pool.addr,
+      cmd_buffer->device->physical->va.internal_surface_state_pool.size,
+      state_offset, ANV_SURFACE_STATE_SIZE, 0, 0, NULL);
+}
+
+static void
+anv_trueos_helioc_dump_v2_heap(struct anv_cmd_buffer *cmd_buffer,
+                               const char *role, struct anv_va_range range)
+{
+   anv_trueos_helioc_dump_v2(role, "heap", MESA_SHADER_NONE, 0, range.addr,
+                              range.size, range.size, 0, 0, 0, 0, 0, 0, 0, NULL);
+}
 static void
