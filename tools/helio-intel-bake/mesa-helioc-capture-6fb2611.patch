+static bool
+write_ir_binary(VkPipelineExecutableInternalRepresentationKHR *ir,
+                const void *data, size_t data_len)
+{
+   ir->isText = VK_FALSE;
+   if (ir->pData == NULL) {
+      ir->dataSize = data_len;
+      return true;
+   }
+   if (ir->dataSize < data_len)
+      return false;
+   memcpy(ir->pData, data, data_len);
+   ir->dataSize = data_len;
+   return true;
+}
+
+/* Capture-only representation.  It exposes the compiler-side descriptor map
+ * without making opaque ANV cache bytes part of the artifact ABI. */
+static char *
+get_shader_trueos_helioc_bind_map_text(const struct anv_shader *shader)
+{
+   char *stream_data = NULL;
+   size_t stream_size = 0;
+   FILE *stream = open_memstream(&stream_data, &stream_size);
+   const struct anv_pipeline_bind_map *map = &shader->bind_map;
+   fprintf(stream, "TRUEOS_HELIOC_BIND_MAP_V1\n");
+   fprintf(stream, "stage=%u layout_type=%u binding_mask=0x%04x surfaces=%u samplers=%u embedded_samplers=%u\n",
+           shader->vk.stage, map->layout_type, map->binding_mask,
+           map->surface_count, map->sampler_count, map->embedded_sampler_count);
+   for (uint32_t i = 0; i < map->surface_count; i++) {
+      const struct anv_pipeline_binding *b = &map->surface_to_descriptor[i];
+      fprintf(stream, "surface[%u]=set:%u binding:%u index:%u offset:%u plane:%u\n",
+              i, b->set, b->binding, b->index, b->set_offset, b->plane);
+   }
+   for (uint32_t i = 0; i < map->sampler_count; i++) {
+      const struct anv_pipeline_binding *b = &map->sampler_to_descriptor[i];
+      fprintf(stream, "sampler[%u]=set:%u binding:%u index:%u offset:%u plane:%u\n",
+              i, b->set, b->binding, b->index, b->set_offset, b->plane);
+   }
+   fclose(stream);
+   return stream_data;
+}
