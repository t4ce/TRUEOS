 'shell3': 'shell3',
 'blueprint': 'blueprints',
 'bp': 'blueprints'}


class DocError(Exception):
    pass


def repo_root() -> Path:
    candidates: list[Path] = []
    if value := os.environ.get("TRUEOS_REPO"):
        candidates.append(Path(value))
    candidates.extend([Path(__file__).resolve().parents[2], Path.cwd(), *Path.cwd().parents])
    for candidate in candidates:
        # Shell2's retired registry is no longer a repository marker. Topics
        # such as logs/references remain useful with the current Shell3 tree.
        if (candidate / "Cargo.toml").is_file() and (candidate / "src/hv/mod.rs").is_file():
            return candidate.resolve()
    raise DocError("TRUEOS repo not found; set TRUEOS_REPO")


def command_registry(root: Path) -> list[dict[str, Any]]:
    """Read current Shell3 name groups, without inventing Shell2 argument schemas."""
    source = (root / "src/shell3/names.rs").read_text(encoding="utf-8")
    entries: list[dict[str, Any]] = []
    groups = re.findall(
        r"\bconst\s+(HV_GROUP_\d+|ADM_NAMES|CAPTURE_NAMES|VME_GROUP)\b[^=]*=\s*(.*?);",
        source, re.S,
    )
    for group, body in groups:
        mode = "hv" if group.startswith("HV_") else "vme" if group == "VME_GROUP" else "adm"
        for name in re.findall(r'NameEntry\s*\{\s*name:\s*"([^"]+)"', body):
            entry: dict[str, Any] = {
                "name": name, "mode": mode, "invocation": name,
                "input": "Exact-name recognition; no appended arguments. VME controls apply to the selected slot.",
                "source": f"src/shell3/names.rs::{group}",
            }
            entry.update(COMMAND_DETAILS.get(name, {}))
            entries.append(entry)
    if not entries:
        raise DocError("Shell3 command name groups are empty")
    return entries


def resolve_topic(name: str) -> tuple[str, dict[str, Any]]:
    key = name.casefold()
    key = ALIASES.get(key, key)
    if key not in TOPICS:
        raise DocError(f"unknown topic: {name}")
    return key, TOPICS[key]


def webcamframe_availability(root: Path) -> dict[str, Any]:
    """Report whether the host utility has become a registered Blueprint."""
    blueprints_root = root.parent / "TRUEOS-Blueprints"
    camframe_root = root.parent / "CamFrame"
    catalog_path = blueprints_root / "apps.json"
    registered_names: set[str] = set()
    catalog_error: str | None = None
    try:
        catalog = json.loads(catalog_path.read_text(encoding="utf-8"))
        for entry in catalog.get("apps", []):
            if isinstance(entry, str):
                registered_names.add(entry)
            elif isinstance(entry, dict) and isinstance(entry.get("name"), str):
                registered_names.add(entry["name"])
    except (OSError, json.JSONDecodeError) as error:
        catalog_error = str(error)

    selectors = ["webcamframe", "webcam-frame"]
    registered = sorted(name for name in selectors if name in registered_names)
    return {
        "camframe_source_present": camframe_root.joinpath("Cargo.toml").is_file(),
        "apps_catalog": str(catalog_path.relative_to(root.parent)),
        "registered_selectors": registered,
        "shell3_startable": bool(registered),
        "status": (
            "registered Blueprint selector present; verify its built/published artifact before launch"
            if registered
            else "not registered in the local Blueprint catalog; host utility only, not Shell3-startable"
        ),
        **({"catalog_error": catalog_error} if catalog_error else {}),
    }


def compact_context(root: Path) -> dict[str, Any]:
    commands = command_registry(root)
    return {
        "purpose": "Current TRUEOS builtin/kernel rig workflow and Shell3 access.",
        "rig_builds": {
            key: TOPICS["rig-builds"][key]
            for key in ("invocation", "release_invocation", "workflow", "build_outputs", "verification")
        },
        "rig": TOPICS["rig"]["physical"] | {"connect": TOPICS["rig"]["connect"], "terminal": TOPICS["rig"]["terminal"]},
        "shell3": {
            "default_mode": TOPICS["shell3"]["default_mode"],
            "tab": TOPICS["shell3"]["tab"],
            "commands": {mode: [entry["name"] for entry in commands if entry["mode"] == mode]
                         for mode in ("hv", "adm", "vme")},
            "recognition": TOPICS["shell3"]["recognition"],
        },
        "headjack": TOPICS["headjack"]["operators"],
        "logs": {
            "filter_invariant": TOPICS["logs"]["filter_invariant"],
            "baremetal_latest": TOPICS["logs"]["captures"]["baremetal"]["latest"],
            "build_integration": TOPICS["logs"]["build_integration"],
        },
        "trueosfs_http": {
            "base_url": TOPICS["trueosfs-http"]["physical_base_url"],
            "discovery": "GET /",
            "download": "GET /dl/<root-id>/<url-encoded-path>",
        },
        "references": {"documents": [item["path"] for item in TOPICS["references"]["documents"]]},
        "next_queries": ["tools/testpy/trueos-doc topic " + name
                         for name in ("rig-builds", "rig", "shell3", "tui", "logs", "trueosfs-http", "references")],
    }


def search(query: str, root: Path, limit: int) -> list[dict[str, Any]]:
    terms = [term.casefold() for term in re.findall(r"[\w§:-]+", query)]
    if not terms:
        raise DocError("search query is empty")
    documents: list[tuple[str, str, Any]] = [("topic", key, value) for key, value in TOPICS.items()]
    documents.extend(("command", item["name"], item) for item in command_registry(root))
    scored = []
    for kind, name, value in documents:
        haystack = json.dumps(value, ensure_ascii=False, sort_keys=True).casefold()
        if kind == "topic":
            haystack += " " + " ".join(alias for alias, target in ALIASES.items() if target == name)
        score = sum(4 if term == name.casefold() else haystack.count(term) for term in terms)
        if score:
            summary = value.get("summary") or value.get("description") or value.get("effect") or ""
            scored.append((score, {"kind": kind, "name": name, "summary": summary}))
    scored.sort(key=lambda item: (-item[0], item[1]["kind"], item[1]["name"]))
    return [item for _, item in scored[:limit]]


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(prog="trueos-doc", description="Machine-readable TRUEOS documentation API")
    result.add_argument("--pretty", action="store_true", help="indent JSON output")
    sub = result.add_subparsers(dest="action")
    sub.add_parser("context", help="return the minimum high-value context")
    topic = sub.add_parser("topic", help="return one curated architectural topic")
    topic.add_argument("name")
    find = sub.add_parser("search", help="search topics and current Shell3 names")
    find.add_argument("query", nargs="+")
    find.add_argument("--limit", type=int, default=8)
    commands = sub.add_parser("commands", help="list command surfaces")
    commands.add_argument("--mode", choices=["cmd", "adm", "hv", "vme", "all"], default="all")
    command = sub.add_parser("command", help="return a current Shell3 command contract")
    command.add_argument("name")
    sub.add_parser("topics", help="list topic names and aliases")
    sub.add_parser("schema", help="describe this CLI's stable command surface")
    return result


def execute(args: argparse.Namespace, root: Path) -> Any:
    action = args.action or "context"
    if action == "context":
        return compact_context(root)
    if action == "topic":
        name, value = resolve_topic(args.name)
        if name == "webcamframe":
            return {"name": name, **value, "availability": webcamframe_availability(root)}
        return {"name": name, **value}
    if action == "search":
        if not 1 <= args.limit <= 100:
            raise DocError("--limit must be in 1..100")
        return {"query": " ".join(args.query), "results": search(" ".join(args.query), root, args.limit)}
    if action == "commands":
        commands = command_registry(root)
        modes = ("cmd", "adm", "hv", "vme") if args.mode == "all" else (args.mode,)
        return {
            "modes": {mode: [entry for entry in commands if entry["mode"] == mode] for mode in modes},
            "cmd_note": "CMD names come from the running AppDB and Aka configuration; no static app catalog is inferred here.",
        }
    if action == "command":
        needle = args.name.casefold()
        matches = [item for item in command_registry(root) if item["name"].casefold() == needle]
        if not matches:
            raise DocError(f"unknown command: {args.name}")
        return matches[0] | {"modes": [item["mode"] for item in matches]}
    if action == "topics":
        return {"topics": sorted(TOPICS), "aliases": ALIASES}
    if action == "schema":
        return {
            "commands": {
                "context": "minimum high-value context (also the default)",
                "topic <name>": "exact curated topic",
                "search <terms> [--limit N]": "ranked discovery",
                "commands [--mode cmd|adm|hv|vme|all]": "current Shell3 names read from Rust source; CMD app names are runtime data",
                "command <name>": "exact command contract",
                "topics": "topic and alias discovery",
            },
            "output": {"content_type": "application/json", "envelope": {"api": API, "ok": "boolean", "data_or_error": "object|string"}},
            "stability": "Context fields describe the current workflow; errors exit 2; no command mutates TRUEOS or the rig.",
        }
    raise DocError(f"unknown action: {action}")


def emit(payload: dict[str, Any], pretty: bool, stream: Any = sys.stdout) -> None:
    json.dump(payload, stream, ensure_ascii=False, sort_keys=True, indent=2 if pretty else None, separators=None if pretty else (",", ":"))
    stream.write("\n")


def main() -> int:
    args = parser().parse_args()
    try:
        root = repo_root()
        data = execute(args, root)
        emit({"api": API, "ok": True, "data": data}, args.pretty)
        return 0
    except (DocError, OSError, ValueError, KeyError) as error:
        emit({"api": API, "ok": False, "error": str(error)}, args.pretty, sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
