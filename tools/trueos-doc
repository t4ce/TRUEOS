class DocError(Exception):
    pass


def repo_root() -> Path:
    candidates: list[Path] = []
    if value := os.environ.get("TRUEOS_REPO"):
        candidates.append(Path(value))
    candidates.extend([Path(__file__).resolve().parent.parent, Path.cwd(), *Path.cwd().parents])
    for candidate in candidates:
        if (candidate / "src/shell2/shell2_cmd_registry.rs").is_file():
            return candidate.resolve()
    raise DocError("TRUEOS repo not found; set TRUEOS_REPO")


def rust_string(body: str, field: str) -> str | None:
    match = re.search(rf"\b{field}:\s*\"([^\"]*)\"", body)
    return match.group(1) if match else None


def command_registry(root: Path) -> list[dict[str, Any]]:
    source = (root / "src/shell2/shell2_cmd_registry.rs").read_text(encoding="utf-8")
    constants = {
        name: json.loads(raw)
        for name, raw in re.findall(r'const\s+(TOOL_JSON_[A-Z0-9_]+):\s*&str\s*=\s*r#"(.*?)"#;', source, re.S)
    }
    start = source.index("const SHELL2_COMMAND_REGISTRY")
    end = source.index("fn starts_with_command", start)
    entries: list[dict[str, Any]] = []
    for body in re.findall(r"BuiltinShell2CmdEntry\s*\{(.*?)\n\s*\},", source[start:end], re.S):
        if not re.search(r"\badvertised:\s*true", body):
            continue
        name = rust_string(body, "name")
        mode = rust_string(body, "mode")
        if not name or not mode:
            raise DocError("could not parse the Shell2 command registry")
        entry: dict[str, Any] = {"name": name, "mode": mode}
        description = re.search(r'tool_description:\s*Some\(\s*"(.*?)"\s*,?\s*\)', body, re.S)
        schema_name = re.search(r"tool_parameters_json:\s*Some\((TOOL_JSON_[A-Z0-9_]+)\)", body)
        if description:
            entry["description"] = re.sub(r"\s+", " ", description.group(1)).strip()
        if schema_name:
            entry["parameters"] = constants[schema_name.group(1)]
        entry["source"] = "src/shell2/shell2_cmd_registry.rs::SHELL2_COMMAND_REGISTRY"
        entries.append(entry)
    if not entries:
        raise DocError("Shell2 command registry is empty")
    return entries


def resolve_topic(name: str) -> tuple[str, dict[str, Any]]:
    key = name.casefold()
    key = ALIASES.get(key, key)
    if key not in TOPICS:
        raise DocError(f"unknown topic: {name}")
    return key, TOPICS[key]


def compact_context(root: Path) -> dict[str, Any]:
    commands = command_registry(root)
    return {
        "purpose": "Minimum context needed to operate and reason about TRUEOS Shell2.",
        "shell2": {
            "default_mode": "cmd",
            "tab": TOPICS["shell2"]["tab"],
            "cmd_commands": [entry["name"] for entry in commands],
            "apps_commands": [entry["name"] for entry in APP_COMMANDS],
        },
        "headjack": TOPICS["headjack"]["operators"],
        "runscripts": {
            "guest_interface": TOPICS["runscripts"]["guest_interface"],
            "shared_directive": TOPICS["runscripts"]["shared_directive"],
            "warning": "Directive grammar belongs to the consuming Blueprint; query topic runscripts before inventing lines.",
        },
        "rig": TOPICS["rig"]["physical"] | {"connect": TOPICS["rig"]["connect"], "qemu_connect": TOPICS["rig"]["qemu"]["connect"]},
        "next_queries": ["trueos-doc topic headjack", "trueos-doc topic tui", "trueos-doc command <name>", "trueos-doc search <terms>"],
    }


def search(query: str, root: Path, limit: int) -> list[dict[str, Any]]:
    terms = [term.casefold() for term in re.findall(r"[\w§:-]+", query)]
    if not terms:
        raise DocError("search query is empty")
    documents: list[tuple[str, str, Any]] = [("topic", key, value) for key, value in TOPICS.items()]
    documents.extend(("command", item["name"], item) for item in command_registry(root))
    documents.extend(("app-command", item["name"], item) for item in APP_COMMANDS)
    scored = []
    for kind, name, value in documents:
        haystack = json.dumps(value, ensure_ascii=False, sort_keys=True).casefold()
        score = sum(4 if term == name.casefold() else haystack.count(term) for term in terms)
        if score:
            summary = value.get("summary") or value.get("description") or value.get("effect") or ""
            scored.append((score, {"kind": kind, "name": name, "summary": summary}))
    scored.sort(key=lambda item: (-item[0], item[1]["kind"], item[1]["name"]))
    return [item for _, item in scored[:limit]]


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(prog="trueos-doc", description="Machine-readable TRUEOS documentation API")
    result.add_argument("--pretty", action="store_true", help="indent JSON output")
    sub = result.add_subparsers(dest="action")
    sub.add_parser("context", help="return the minimum high-value context")
    topic = sub.add_parser("topic", help="return one curated architectural topic")
    topic.add_argument("name")
    find = sub.add_parser("search", help="search topics and Shell2 commands")
    find.add_argument("query", nargs="+")
    find.add_argument("--limit", type=int, default=8)
    commands = sub.add_parser("commands", help="list command surfaces")
    commands.add_argument("--mode", choices=["cmd", "apps", "all"], default="all")
    command = sub.add_parser("command", help="return one command and its JSON Schema")
    command.add_argument("name")
    sub.add_parser("topics", help="list topic names and aliases")
    sub.add_parser("schema", help="describe this CLI's stable command surface")
    return result


def execute(args: argparse.Namespace, root: Path) -> Any:
    action = args.action or "context"
    if action == "context":
        return compact_context(root)
    if action == "topic":
        name, value = resolve_topic(args.name)
        return {"name": name, **value}
    if action == "search":
        if not 1 <= args.limit <= 100:
            raise DocError("--limit must be in 1..100")
        return {"query": " ".join(args.query), "results": search(" ".join(args.query), root, args.limit)}
    if action == "commands":
        result: dict[str, Any] = {}
        if args.mode in ("cmd", "all"):
            result["cmd"] = command_registry(root)
        if args.mode in ("apps", "all"):
            result["apps"] = APP_COMMANDS
        return result
    if action == "command":
        needle = args.name.casefold()
        matches = [item for item in command_registry(root) if item["name"].casefold() == needle]
        matches.extend(item for item in APP_COMMANDS if item["name"].casefold() == needle or needle in item.get("aliases", []))
        if not matches:
            raise DocError(f"unknown command: {args.name}")
        return matches[0]
    if action == "topics":
        return {"topics": sorted(TOPICS), "aliases": ALIASES}
    if action == "schema":
        return {
            "commands": {
                "context": "minimum high-value context (also the default)",
                "topic <name>": "exact curated topic",
                "search <terms> [--limit N]": "ranked discovery",
                "commands [--mode cmd|apps|all]": "command catalogs; cmd entries include live Rust JSON Schemas",
                "command <name>": "exact command contract",
                "topics": "topic and alias discovery",
            },
            "output": {"content_type": "application/json", "envelope": {"api": API, "ok": "boolean", "data_or_error": "object|string"}},
            "stability": "API v1 fields are additive; errors exit 2; no command mutates TRUEOS or the rig.",
        }
    raise DocError(f"unknown action: {action}")


def emit(payload: dict[str, Any], pretty: bool, stream: Any = sys.stdout) -> None:
    json.dump(payload, stream, ensure_ascii=False, sort_keys=True, indent=2 if pretty else None, separators=None if pretty else (",", ":"))
    stream.write("\n")


def main() -> int:
    args = parser().parse_args()
    try:
        root = repo_root()
        data = execute(args, root)
        emit({"api": API, "ok": True, "data": data}, args.pretty)
        return 0
    except (DocError, OSError, ValueError, KeyError) as error:
        emit({"api": API, "ok": False, "error": str(error)}, args.pretty, sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
