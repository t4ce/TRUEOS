    "log": "logs", "logging": "logs", "logfile": "logs", "logfiles": "logs", "logtier": "logs", "logtiers": "logs", "levels": "logs",
    "make": "make-iso", "iso": "make-iso", "make iso": "make-iso", "baremetal-redeploy": "make-iso", "redeploy": "make-iso", "physical-deploy": "make-iso",
