    inline mat2() : c0((float2)(1.0f, 0.0f)), c1((float2)(0.0f, 1.0f)) {}
    inline mat2(float d) : c0((float2)(d, 0.0f)), c1((float2)(0.0f, d)) {}
    inline mat2(float a, float b, float c, float d)
        : c0((float2)(a, b)), c1((float2)(c, d)) {}
