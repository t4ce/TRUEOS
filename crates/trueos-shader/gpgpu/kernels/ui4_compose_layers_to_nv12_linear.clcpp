// TRUEOS UI4 fused logical-composition to RDP NV12 kernel for Alder Lake S.
// Canonical source language: C++ for OpenCL.
//
// One SIMD16 work-item produces one 2x2 NV12 macro-pixel. Each of the four
// nearest-neighbour logical scanout samples is composed from the explicit RDP
// layer table in plane/z order and converted in registers. No full-resolution
// RGBA mirror, CPU pixel pass, or GPU-to-CPU ownership transition exists.

#define UI4_LAYER_DWORDS 12u
#define UI4_LAYER_FLAG_BGRA (1u << 0)

static inline uint div255(uint value)
{
    return (value + 127u) / 255u;
}

static inline uint swap_red_blue(uint color)
{
    return (color & 0xFF00FF00u)
        | ((color & 0x000000FFu) << 16)
        | ((color & 0x00FF0000u) >> 16);
}

static inline uint apply_opacity(uint src, uint opacity)
{
    if (opacity >= 255u) {
        return src;
    }
    uint r = div255((src & 0xFFu) * opacity);
    uint g = div255(((src >> 8) & 0xFFu) * opacity);
    uint b = div255(((src >> 16) & 0xFFu) * opacity);
    uint a = div255(((src >> 24) & 0xFFu) * opacity);
    return (a << 24) | (b << 16) | (g << 8) | r;
}

static inline uint premul_src_over(uint src, uint dst)
{
    uint sa = (src >> 24) & 0xFFu;
    if (sa == 0u) {
        return dst;
    }
    if (sa == 255u) {
        return src | 0xFF000000u;
    }

    uint inv = 255u - sa;
    uint r = min((src & 0xFFu) + div255((dst & 0xFFu) * inv), 255u);
    uint g = min(((src >> 8) & 0xFFu) + div255(((dst >> 8) & 0xFFu) * inv), 255u);
    uint b = min(((src >> 16) & 0xFFu) + div255(((dst >> 16) & 0xFFu) * inv), 255u);
    uint a = min(sa + div255(((dst >> 24) & 0xFFu) * inv), 255u);
    return (a << 24) | (b << 16) | (g << 8) | r;
}

static inline uint compose_logical_pixel(
    __global const uint *layers,
    uint layer_count,
    uint x,
    uint y)
{
    uint color = 0u;
    __attribute__((opencl_unroll_hint(1)))
    for (uint layer_index = 0u; layer_index < layer_count; ++layer_index) {
        uint d = layer_index * UI4_LAYER_DWORDS;
        ulong src_gpu = ((ulong)layers[d + 1u] << 32) | (ulong)layers[d + 0u];
        uint src_pitch_pixels = layers[d + 2u] >> 2;
        uint src_width = layers[d + 3u];
        uint src_height = layers[d + 4u];
        int dst_x = as_int(layers[d + 5u]);
        int dst_y = as_int(layers[d + 6u]);
        uint layer_width = layers[d + 7u];
        uint layer_height = layers[d + 8u];
        uint opacity = min(layers[d + 9u], 255u);
        uint flags = layers[d + 10u];

        int rel_x = (int)x - dst_x;
        int rel_y = (int)y - dst_y;
        if (rel_x < 0 || rel_y < 0 || (uint)rel_x >= layer_width
            || (uint)rel_y >= layer_height || src_width == 0u || src_height == 0u
            || layer_width == 0u || layer_height == 0u) {
            continue;
        }

        uint sx = min(((uint)rel_x * src_width) / layer_width, src_width - 1u);
        uint sy = min(((uint)rel_y * src_height) / layer_height, src_height - 1u);
        __global const uint *src_rgba = (__global const uint *)src_gpu;
        uint src = src_rgba[sy * src_pitch_pixels + sx];
        if ((flags & UI4_LAYER_FLAG_BGRA) != 0u) {
            src = swap_red_blue(src);
        }
        color = premul_src_over(apply_opacity(src, opacity), color);
    }
    return color;
}

static inline uchar rgb_to_luma(uint color)
{
    int red = (int)(color & 0xFFu);
    int green = (int)((color >> 8) & 0xFFu);
    int blue = (int)((color >> 16) & 0xFFu);
    int value = ((66 * red + 129 * green + 25 * blue + 128) >> 8) + 16;
    return (uchar)clamp(value, 16, 235);
}

static inline uint nearest_source_coordinate(uint destination, uint source_size, uint destination_size)
{
    ulong numerator = ((ulong)destination * 2ul + 1ul) * (ulong)source_size;
    return (uint)(numerator / ((ulong)destination_size * 2ul));
}

__attribute__((intel_reqd_sub_group_size(16)))
__kernel void ui4_compose_layers_to_nv12_linear(
    __global const uint *layers,
    __global uint *dst_nv12_words,
    uint logical_width,
    uint logical_height,
    uint dst_pitch_bytes,
    uint dst_width,
    uint dst_height,
    uint active_top,
    uint active_height,
    uint layer_count)
{
    __global uchar *dst_nv12 = (__global uchar *)dst_nv12_words;
    uint dst_x = get_global_id(0) * 2u;
    uint dst_y = get_global_id(1) * 2u;
    if (dst_x >= dst_width || dst_y >= dst_height) {
        return;
    }

    uint uv_offset = dst_pitch_bytes * dst_height;
    uint y_row_0 = dst_y * dst_pitch_bytes;
    uint y_row_1 = (dst_y + 1u) * dst_pitch_bytes;
    uint uv_row = uv_offset + (dst_y >> 1) * dst_pitch_bytes;
    if (dst_y < active_top || dst_y >= active_top + active_height) {
        dst_nv12[y_row_0 + dst_x] = (uchar)16;
        dst_nv12[y_row_0 + dst_x + 1u] = (uchar)16;
        dst_nv12[y_row_1 + dst_x] = (uchar)16;
        dst_nv12[y_row_1 + dst_x + 1u] = (uchar)16;
        dst_nv12[uv_row + dst_x] = (uchar)128;
        dst_nv12[uv_row + dst_x + 1u] = (uchar)128;
        return;
    }

    uint active_y = dst_y - active_top;
    uint src_x_0 = nearest_source_coordinate(dst_x, logical_width, dst_width);
    uint src_x_1 = nearest_source_coordinate(dst_x + 1u, logical_width, dst_width);
    uint src_y_0 = nearest_source_coordinate(active_y, logical_height, active_height);
    uint src_y_1 = nearest_source_coordinate(active_y + 1u, logical_height, active_height);
    if (src_x_1 >= logical_width || src_y_1 >= logical_height) {
        return;
    }

    uint rgba00 = compose_logical_pixel(layers, layer_count, src_x_0, src_y_0);
    uint rgba01 = compose_logical_pixel(layers, layer_count, src_x_1, src_y_0);
    uint rgba10 = compose_logical_pixel(layers, layer_count, src_x_0, src_y_1);
    uint rgba11 = compose_logical_pixel(layers, layer_count, src_x_1, src_y_1);

    dst_nv12[y_row_0 + dst_x] = rgb_to_luma(rgba00);
    dst_nv12[y_row_0 + dst_x + 1u] = rgb_to_luma(rgba01);
    dst_nv12[y_row_1 + dst_x] = rgb_to_luma(rgba10);
    dst_nv12[y_row_1 + dst_x + 1u] = rgb_to_luma(rgba11);

    uint red = ((rgba00 & 0xFFu) + (rgba01 & 0xFFu)
        + (rgba10 & 0xFFu) + (rgba11 & 0xFFu)) >> 2;
    uint green = (((rgba00 >> 8) & 0xFFu) + ((rgba01 >> 8) & 0xFFu)
        + ((rgba10 >> 8) & 0xFFu) + ((rgba11 >> 8) & 0xFFu)) >> 2;
    uint blue = (((rgba00 >> 16) & 0xFFu) + ((rgba01 >> 16) & 0xFFu)
        + ((rgba10 >> 16) & 0xFFu) + ((rgba11 >> 16) & 0xFFu)) >> 2;
    int u = ((-38 * (int)red - 74 * (int)green + 112 * (int)blue + 128) >> 8) + 128;
    int v = ((112 * (int)red - 94 * (int)green - 18 * (int)blue + 128) >> 8) + 128;
    dst_nv12[uv_row + dst_x] = (uchar)clamp(u, 16, 240);
    dst_nv12[uv_row + dst_x + 1u] = (uchar)clamp(v, 16, 240);
}
