// Staged vector-font compute bring-up.
// Canonical source language: C++ for OpenCL.
//
// The CPU uploads size-independent Skrifa outline records once. Stage 1 checks
// the ABI, stage 2 flattens curves into point storage, and stage 3 emits an
// indexed contour-stroke mesh. The stroke mesh is intentionally not presented
// as fill tessellation: hole-aware contour resolution is the next artifact.

#define OP_WORDS 8u
#define OP_MOVE 0u
#define OP_LINE 1u
#define OP_QUAD 2u
#define OP_CUBIC 3u
#define OP_CLOSE 4u

#define STAGE_AUDIT 1u
#define STAGE_FLATTEN 2u
#define STAGE_STROKE_MESH 3u

#define REPORT_DWORDS 64u
#define VERTEX_DWORD_OFFSET 64u
#define INDEX_DWORD_OFFSET 8192u
#define OUTPUT_LAYOUT_VERSION 2u
#define RESULT_MAGIC 0xF07ECA00u
#define RESULT_DONE 0xC001D00Du

// Keep private state in the kernel body. Passing private pointers through
// helper functions makes current IGC emit a callable-symbol program plus a
// constant-base payload that the direct-RCS ABI intentionally does not expose.
#define INCLUDE_BOUNDS(point_value) do { \
    float2 bounds_point_ = (point_value); \
    if (have_bounds == 0u) { \
        bounds_lo = bounds_point_; \
        bounds_hi = bounds_point_; \
        have_bounds = 1u; \
    } else { \
        bounds_lo = fmin(bounds_lo, bounds_point_); \
        bounds_hi = fmax(bounds_hi, bounds_point_); \
    } \
} while (0)

#define EMIT_FLAT_POINT(point_value) do { \
    float2 flat_point_ = (point_value); \
    if (vertex_count >= max_vertices) { \
        truncated = 1u; \
    } else { \
        uint flat_word_ = VERTEX_DWORD_OFFSET + vertex_count * 2u; \
        output[flat_word_] = as_uint(flat_point_.x); \
        output[flat_word_ + 1u] = as_uint(flat_point_.y); \
        vertex_count += 1u; \
    } \
} while (0)

#define EMIT_STROKE_SEGMENT(a_value, b_value) do { \
    float2 stroke_a_ = (a_value); \
    float2 stroke_b_ = (b_value); \
    float2 stroke_delta_ = stroke_b_ - stroke_a_; \
    float stroke_length2_ = dot(stroke_delta_, stroke_delta_); \
    if (stroke_length2_ > 0.000001f) { \
        if (vertex_count + 4u > max_vertices || index_count + 6u > max_indices) { \
            truncated = 1u; \
        } else { \
            float stroke_inv_length_ = native_rsqrt(stroke_length2_); \
            float2 stroke_normal_ = (float2)(-stroke_delta_.y, stroke_delta_.x) \
                * (stroke_half_width * stroke_inv_length_); \
            float2 stroke_q0_ = stroke_a_ + stroke_normal_; \
            float2 stroke_q1_ = stroke_a_ - stroke_normal_; \
            float2 stroke_q2_ = stroke_b_ + stroke_normal_; \
            float2 stroke_q3_ = stroke_b_ - stroke_normal_; \
            uint stroke_base_ = vertex_count; \
            uint stroke_vertex_word_ = VERTEX_DWORD_OFFSET + stroke_base_ * 2u; \
            output[stroke_vertex_word_ + 0u] = as_uint(stroke_q0_.x); \
            output[stroke_vertex_word_ + 1u] = as_uint(stroke_q0_.y); \
            output[stroke_vertex_word_ + 2u] = as_uint(stroke_q1_.x); \
            output[stroke_vertex_word_ + 3u] = as_uint(stroke_q1_.y); \
            output[stroke_vertex_word_ + 4u] = as_uint(stroke_q2_.x); \
            output[stroke_vertex_word_ + 5u] = as_uint(stroke_q2_.y); \
            output[stroke_vertex_word_ + 6u] = as_uint(stroke_q3_.x); \
            output[stroke_vertex_word_ + 7u] = as_uint(stroke_q3_.y); \
            uint stroke_index_word_ = INDEX_DWORD_OFFSET + index_count; \
            output[stroke_index_word_ + 0u] = stroke_base_ + 0u; \
            output[stroke_index_word_ + 1u] = stroke_base_ + 1u; \
            output[stroke_index_word_ + 2u] = stroke_base_ + 2u; \
            output[stroke_index_word_ + 3u] = stroke_base_ + 2u; \
            output[stroke_index_word_ + 4u] = stroke_base_ + 1u; \
            output[stroke_index_word_ + 5u] = stroke_base_ + 3u; \
            vertex_count += 4u; \
            index_count += 6u; \
        } \
    } \
} while (0)

#define EMIT_SEGMENT(a_value, b_value) do { \
    segment_count += 1u; \
    if (stage == STAGE_FLATTEN) { \
        EMIT_FLAT_POINT(b_value); \
    } else if (stage == STAGE_STROKE_MESH) { \
        EMIT_STROKE_SEGMENT(a_value, b_value); \
    } \
} while (0)

__attribute__((intel_reqd_sub_group_size(16)))
__kernel void font_outline_mesh(
    __global const uint *outline_ops,
    __global uint *output,
    uint op_count,
    uint stage,
    uint subdivisions,
    uint max_vertices,
    uint max_indices,
    float scale,
    float origin_x,
    float origin_y,
    float stroke_half_width
) {
    if (get_global_id(0) != 0u) {
        return;
    }

    for (uint i = 0u; i < REPORT_DWORDS; ++i) {
        output[i] = 0u;
    }

    subdivisions = clamp(subdivisions, 1u, 32u);
    uint checksum = 0x811C9DC5u;
    uint move_count = 0u;
    uint line_count = 0u;
    uint quad_count = 0u;
    uint cubic_count = 0u;
    uint close_count = 0u;
    uint invalid = 0u;
    uint truncated = 0u;
    uint vertex_count = 0u;
    uint index_count = 0u;
    uint segment_count = 0u;
    uint have_current = 0u;
    uint contour_open = 0u;
    uint have_bounds = 0u;
    float2 current = (float2)(0.0f, 0.0f);
    float2 contour_start = current;
    float2 bounds_lo = current;
    float2 bounds_hi = current;
    float2 origin = (float2)(origin_x, origin_y);

    for (uint op_index = 0u; op_index < op_count; ++op_index) {
        uint base = op_index * OP_WORDS;
        for (uint word = 0u; word < OP_WORDS; ++word) {
            checksum ^= outline_ops[base + word];
            checksum *= 0x01000193u;
        }
        uint kind = outline_ops[base];
        if (kind > OP_CLOSE) {
            invalid += 1u;
            continue;
        }
        if (kind == OP_MOVE) move_count += 1u;
        else if (kind == OP_LINE) line_count += 1u;
        else if (kind == OP_QUAD) quad_count += 1u;
        else if (kind == OP_CUBIC) cubic_count += 1u;
        else close_count += 1u;

        float2 raw0 = (float2)(as_float(outline_ops[base + 1u]), as_float(outline_ops[base + 2u]));
        float2 raw1 = (float2)(as_float(outline_ops[base + 3u]), as_float(outline_ops[base + 4u]));
        float2 raw2 = (float2)(as_float(outline_ops[base + 5u]), as_float(outline_ops[base + 6u]));
        uint coords_ok = 1u;
        if (kind == OP_MOVE || kind == OP_LINE) {
            coords_ok = all(isfinite(raw0));
        } else if (kind == OP_QUAD) {
            coords_ok = all(isfinite(raw0)) && all(isfinite(raw1));
        } else if (kind == OP_CUBIC) {
            coords_ok = all(isfinite(raw0)) && all(isfinite(raw1)) && all(isfinite(raw2));
        }
        uint sequence_ok = 1u;
        if (kind == OP_MOVE) {
            contour_open = 1u;
        } else if (kind == OP_CLOSE) {
            sequence_ok = contour_open;
            contour_open = 0u;
        } else {
            sequence_ok = contour_open;
        }
        if (coords_ok == 0u || sequence_ok == 0u || outline_ops[base + 7u] != 0u) {
            invalid += 1u;
            if (stage != STAGE_AUDIT) {
                continue;
            }
        }

        if (stage == STAGE_AUDIT) {
            continue;
        }

        // The render viewport already has a negative Y scale. Preserve the
        // font's Y-up coordinates so ascenders remain above the baseline.
        float2 p0 = origin + raw0 * scale;
        float2 p1 = origin + raw1 * scale;
        float2 p2 = origin + raw2 * scale;

        if (kind == OP_MOVE) {
            current = p0;
            contour_start = p0;
            have_current = 1u;
            INCLUDE_BOUNDS(current);
            if (stage == STAGE_FLATTEN) {
                EMIT_FLAT_POINT(current);
            }
        } else if (kind == OP_LINE && have_current != 0u) {
            INCLUDE_BOUNDS(p0);
            EMIT_SEGMENT(current, p0);
            current = p0;
        } else if (kind == OP_QUAD && have_current != 0u) {
            float2 start = current;
            for (uint step = 1u; step <= subdivisions; ++step) {
                float t = (float)step / (float)subdivisions;
                float one = 1.0f - t;
                float2 point = one * one * start + 2.0f * one * t * p0 + t * t * p1;
                INCLUDE_BOUNDS(point);
                EMIT_SEGMENT(current, point);
                current = point;
            }
        } else if (kind == OP_CUBIC && have_current != 0u) {
            float2 start = current;
            for (uint step = 1u; step <= subdivisions; ++step) {
                float t = (float)step / (float)subdivisions;
                float one = 1.0f - t;
                float2 point = one * one * one * start
                    + 3.0f * one * one * t * p0
                    + 3.0f * one * t * t * p1
                    + t * t * t * p2;
                INCLUDE_BOUNDS(point);
                EMIT_SEGMENT(current, point);
                current = point;
            }
        } else if (kind == OP_CLOSE && have_current != 0u) {
            EMIT_SEGMENT(current, contour_start);
            current = contour_start;
            have_current = 0u;
        } else if (kind != OP_CLOSE) {
            invalid += 1u;
        }
    }

    if (contour_open != 0u) {
        invalid += 1u;
    }

    uint valid_stage = stage >= STAGE_AUDIT && stage <= STAGE_STROKE_MESH;
    uint status = (invalid == 0u && valid_stage != 0u) ? 1u : 0u;
    output[0] = RESULT_MAGIC | (stage & 0xFFu);
    output[1] = status | (truncated << 1u);
    output[2] = stage;
    output[3] = op_count;
    output[4] = move_count;
    output[5] = line_count;
    output[6] = quad_count;
    output[7] = cubic_count;
    output[8] = close_count;
    output[9] = vertex_count;
    output[10] = segment_count;
    output[11] = stage == STAGE_STROKE_MESH ? vertex_count : 0u;
    output[12] = index_count;
    output[13] = checksum;
    output[14] = invalid;
    output[15] = truncated;
    output[16] = as_uint(bounds_lo.x);
    output[17] = as_uint(bounds_lo.y);
    output[18] = as_uint(bounds_hi.x);
    output[19] = as_uint(bounds_hi.y);
    output[20] = subdivisions;
    output[21] = OUTPUT_LAYOUT_VERSION;
    output[22] = VERTEX_DWORD_OFFSET;
    output[23] = INDEX_DWORD_OFFSET;
    output[24] = RESULT_DONE;
}
