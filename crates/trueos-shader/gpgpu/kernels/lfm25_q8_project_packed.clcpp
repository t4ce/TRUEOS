// Fixed packed LFM2.5-350M Q8_0 projection for the TRUEOS C++/IGC lane.
//
// This is the first graph-native model layout, deliberately specialized to
// the sealed 350M model.  Sixteen adjacent rows are transposed together for
// each 32-value Q8 block:
//
//   [16 binary16 scales][word 0 for rows 0..15] ... [word 7 for rows 0..15]
//
// The tile remains exactly 16 * 34 = 544 bytes, so every tensor keeps its
// sealed byte offset and extent.  A SIMD16 work-group reads one coalesced
// signed-int8 dword per lane and uses eight integer dot products per block.
//
// Activations use a graph-native 36-byte block: binary16 scale, binary16
// padding, then eight packed signed-int8 dwords.  The padding removes every
// unaligned activation load and is also the ABI the future GPU quantizer will
// produce directly.

#include "include/trueos_clcpp.hpp"

namespace trueos::gpgpu::lfm25::packed {

inline constexpr uint hidden = 1024u;
inline constexpr uint ffn = 4608u;
inline constexpr uint vocabulary = 65536u;
inline constexpr uint q8_values = 32u;
inline constexpr uint rows_per_tile = 16u;
inline constexpr uint scale_words_per_tile = 8u;
inline constexpr uint dot_words_per_block = 8u;
inline constexpr uint packed_tile_words = 136u;       // 544 bytes
inline constexpr uint activation_block_words = 9u;   // 36 bytes

__attribute__((always_inline)) inline bool admitted_shape(
    uint columns,
    uint rows)
{
    if (columns == hidden) {
        return rows == 512u
            || rows == hidden
            || rows == 3072u
            || rows == ffn
            || rows == vocabulary;
    }
    return columns == ffn && rows == hidden;
}

__attribute__((always_inline)) inline float binary16_to_float(ushort bits)
{
    return convert_float(as_half(bits));
}

} // namespace trueos::gpgpu::lfm25::packed

TRUEOS_REQD_SUB_GROUP_SIZE_16
__kernel void lfm25_q8_project_packed(
    __global const uint *weights,
    __global const uint *activation,
    __global float *output,
    uint weight_offset,
    uint columns,
    uint rows)
{
    using namespace trueos::gpgpu::lfm25::packed;

    const uint row = static_cast<uint>(get_global_id(0));
    if (!admitted_shape(columns, rows) || row >= rows) {
        return;
    }

    const uint lane = row & (rows_per_tile - 1u);
    const uint row_tile = row / rows_per_tile;
    const uint blocks_per_row = columns / q8_values;
    const uint tensor_word_offset = weight_offset >> 2u;
    float sum0 = 0.0f;
    float sum1 = 0.0f;
    float sum2 = 0.0f;
    float sum3 = 0.0f;
    float sum4 = 0.0f;
    float sum5 = 0.0f;
    float sum6 = 0.0f;
    float sum7 = 0.0f;

    for (uint block = 0u; block < blocks_per_row; ++block) {
        const uint tile_block =
            tensor_word_offset
            + (row_tile * blocks_per_row + block) * packed_tile_words;
        const uint scale_word = weights[tile_block + (lane >> 1u)];
        const uint scale_shift = (lane & 1u) << 4u;
        const ushort weight_scale_bits =
            static_cast<ushort>((scale_word >> scale_shift) & 0xffffu);

        const uint activation_block = block * activation_block_words;
        const ushort activation_scale_bits =
            static_cast<ushort>(activation[activation_block] & 0xffffu);
        const float scale =
            binary16_to_float(weight_scale_bits)
            * binary16_to_float(activation_scale_bits);

        const uint weight_words =
            tile_block + scale_words_per_tile + lane;
        const uint activation_words = activation_block + 1u;
        const int dot0 = dot_4x8packed_ss_int(
            weights[weight_words + 0u * rows_per_tile],
            activation[activation_words + 0u]);
        const int dot1 = dot_4x8packed_ss_int(
            weights[weight_words + 1u * rows_per_tile],
            activation[activation_words + 1u]);
        const int dot2 = dot_4x8packed_ss_int(
            weights[weight_words + 2u * rows_per_tile],
            activation[activation_words + 2u]);
        const int dot3 = dot_4x8packed_ss_int(
            weights[weight_words + 3u * rows_per_tile],
            activation[activation_words + 3u]);
        const int dot4 = dot_4x8packed_ss_int(
            weights[weight_words + 4u * rows_per_tile],
            activation[activation_words + 4u]);
        const int dot5 = dot_4x8packed_ss_int(
            weights[weight_words + 5u * rows_per_tile],
            activation[activation_words + 5u]);
        const int dot6 = dot_4x8packed_ss_int(
            weights[weight_words + 6u * rows_per_tile],
            activation[activation_words + 6u]);
        const int dot7 = dot_4x8packed_ss_int(
            weights[weight_words + 7u * rows_per_tile],
            activation[activation_words + 7u]);

        sum0 = fma(scale, static_cast<float>(dot0), sum0);
        sum1 = fma(scale, static_cast<float>(dot1), sum1);
        sum2 = fma(scale, static_cast<float>(dot2), sum2);
        sum3 = fma(scale, static_cast<float>(dot3), sum3);
        sum4 = fma(scale, static_cast<float>(dot4), sum4);
        sum5 = fma(scale, static_cast<float>(dot5), sum5);
        sum6 = fma(scale, static_cast<float>(dot6), sum6);
        sum7 = fma(scale, static_cast<float>(dot7), sum7);
    }

    const float low0 = sum0 + sum4;
    const float low1 = sum1 + sum5;
    const float low2 = sum2 + sum6;
    const float low3 = sum3 + sum7;
    output[row] = (low0 + low2) + (low1 + low3);
}
