// TRUEOS C++ for OpenCL generative demo suite.
//
// One stable output ABI exposes several deliberately different workloads:
// - gallery: four live panels in one surface;
// - aurora: vector/transcendental field evaluation;
// - julia: bounded iterative control flow;
// - sdf: signed-distance geometry and analytical antialiasing;
// - voronoi: integer hashing and neighbourhood search.
// - retro sun: layered synthwave sky, banded sun, ocean, and CRT treatment.
//
// The complete compiler stack remains offline. TRUEOS embeds only the audited
// SPIR-V/Zebin pair and submits it through the existing direct-RCS/GuC path.

#include "include/trueos_clcpp.hpp"
#include "presets/cloud_high_wisps_preset.hpp"

namespace trueos::gpgpu::cpp_demo {

#define TRUEOS_CPP_DEMO_INLINE __attribute__((always_inline)) inline

inline constexpr uint mode_gallery = 0u;
inline constexpr uint mode_aurora = 1u;
inline constexpr uint mode_julia = 2u;
inline constexpr uint mode_sdf = 3u;
inline constexpr uint mode_voronoi = 4u;
inline constexpr uint mode_retro_sun = 5u;
// Fixed scene reconstructed from
// cloud-engine-config_2026-08-23_06-14-45.json. The source config was saved
// in draw mode, which intentionally has no serialized density volume; this
// mode therefore uses its selected High wisps formation as deterministic auto
// source material rather than presenting an empty saved scene.
inline constexpr uint mode_cloud_high_wisps = 6u;
inline constexpr uint mode_count = 7u;

TRUEOS_CPP_DEMO_INLINE float saturate(float value)
{
    return clamp(value, 0.0f, 1.0f);
}

TRUEOS_CPP_DEMO_INLINE float2 rotate(float2 point, float angle)
{
    const float sine = native_sin(angle);
    const float cosine = native_cos(angle);
    return (float2)(
        point.x * cosine - point.y * sine,
        point.x * sine + point.y * cosine);
}

TRUEOS_CPP_DEMO_INLINE float vector_length(float2 value)
{
    return native_sqrt(dot(value, value));
}

TRUEOS_CPP_DEMO_INLINE uint pack_opaque(float3 color)
{
    const float3 bounded = clamp(color, (float3)(0.0f), (float3)(1.0f));
    const uint red = static_cast<uint>(bounded.x * 255.0f + 0.5f);
    const uint green = static_cast<uint>(bounded.y * 255.0f + 0.5f);
    const uint blue = static_cast<uint>(bounded.z * 255.0f + 0.5f);
    return 0xFF000000u | (blue << 16) | (green << 8) | red;
}

TRUEOS_CPP_DEMO_INLINE float3 cosine_palette(
    float value,
    float3 base,
    float3 amplitude,
    float3 frequency,
    float3 phase)
{
    constexpr float tau = 6.28318530718f;
    return base + amplitude * native_cos(tau * (frequency * value + phase));
}

TRUEOS_CPP_DEMO_INLINE uint hash_u32(uint value)
{
    value ^= value >> 16;
    value *= 0x7FEB352Du;
    value ^= value >> 15;
    value *= 0x846CA68Bu;
    value ^= value >> 16;
    return value;
}

TRUEOS_CPP_DEMO_INLINE float hash_unit(int2 cell, uint seed, uint lane)
{
    const uint x = as_uint(cell.x);
    const uint y = as_uint(cell.y);
    const uint mixed =
        hash_u32(x * 0x9E3779B9u ^ y * 0x85EBCA6Bu ^ seed ^ lane * 0xC2B2AE35u);
    return static_cast<float>(mixed & 0x00FFFFFFu) * (1.0f / 16777216.0f);
}

TRUEOS_CPP_DEMO_INLINE float value_noise(float2 point, uint seed)
{
    const float2 floored = floor(point);
    const int2 cell = convert_int2_rtn(floored);
    const float2 fraction = point - floored;
    const float2 blend = fraction * fraction * (3.0f - 2.0f * fraction);
    const float lower = mix(
        hash_unit(cell, seed, 0u),
        hash_unit(cell + (int2)(1, 0), seed, 0u),
        blend.x);
    const float upper = mix(
        hash_unit(cell + (int2)(0, 1), seed, 0u),
        hash_unit(cell + (int2)(1, 1), seed, 0u),
        blend.x);
    return mix(lower, upper, blend.y);
}

TRUEOS_CPP_DEMO_INLINE float retro_circle(
    float2 point,
    float2 center,
    float radius,
    float blur)
{
    return 1.0f - smoothstep(
        radius - blur,
        radius + blur,
        vector_length(point - center));
}

TRUEOS_CPP_DEMO_INLINE float retro_line_band(
    float value,
    float center,
    float half_width,
    float softness)
{
    return 1.0f - smoothstep(
        half_width,
        half_width + softness,
        fabs(value - center));
}

TRUEOS_CPP_DEMO_INLINE float3 retro_sun_palette(float value)
{
    const float3 top = (float3)(1.0f, 0.16f, 0.55f);
    const float3 middle = (float3)(1.0f, 0.46f, 0.12f);
    const float3 lower = (float3)(1.0f, 0.92f, 0.20f);
    const float3 upper_gradient =
        mix(middle, top, smoothstep(0.35f, 1.0f, value));
    return mix(
        lower,
        upper_gradient,
        smoothstep(0.0f, 0.85f, value));
}

TRUEOS_CPP_DEMO_INLINE float3 render_retro_sun(
    float2 uv,
    float2 pixel,
    float2 extent,
    float time,
    uint seed)
{
    constexpr float pi = 3.14159265359f;
    const float2 sun_center = (float2)(0.0f, 0.18f);

    // UI4 rows run top-to-bottom; the reference fragment space is bottom-up.
    float2 point = (float2)(uv.x, -uv.y);
    const float radius_squared = dot(point, point);
    point *= 1.0f + radius_squared * 0.055f;

    const float3 sky_top = (float3)(0.07f, 0.00f, 0.18f);
    const float3 sky_bottom = (float3)(0.01f, 0.00f, 0.05f);
    float3 color = mix(
        sky_bottom,
        sky_top,
        smoothstep(-0.8f, 0.9f, point.y));

    const float horizon_distance = fabs(point.y + 0.30f);
    const float horizon = 1.0f - smoothstep(0.03f, 0.44f, horizon_distance);
    color += (float3)(0.35f, 0.02f, 0.38f) * horizon;
    color += (float3)(0.06f, 0.00f, 0.20f)
        * (1.0f - smoothstep(-0.8f, 0.9f, point.y));

    const float sun = retro_circle(point, sun_center, 0.48f, 0.012f);
    const float sun_y = saturate((point.y - (sun_center.y - 0.48f)) / 0.96f);
    const float3 sun_color = retro_sun_palette(sun_y);

    float bands = 0.0f;
    for (uint band = 0u; band < 12u; ++band) {
        const float band_f = static_cast<float>(band);
        const float band_y = sun_center.y - 0.34f + band_f * 0.064f;
        const float wave =
            native_sin(point.x * 9.0f + time * 1.9f + band_f * 0.85f) * 0.013f;
        const float thickness = mix(0.010f, 0.030f, band_f / 12.0f);
        bands += retro_line_band(point.y, band_y + wave, thickness, 0.006f);
    }
    const float band_cut = saturate(bands);

    const float surface_noise =
        value_noise((float2)(point.x * 2.0f, time * 0.35f), seed ^ 0x51A7u);
    float shimmer = native_sin(
        (point.y + surface_noise) * 95.0f + time * 4.0f);
    shimmer = smoothstep(0.58f, 1.0f, shimmer)
        * smoothstep(-0.30f, 0.55f, point.y);
    color = mix(
        color,
        sun_color + (float3)(0.18f, 0.02f, 0.08f) * shimmer,
        sun * (1.0f - band_cut * 0.92f));

    const float glow =
        native_exp(-vector_length(point - sun_center) * 2.6f) * 0.95f;
    color += (float3)(1.0f, 0.08f, 0.55f) * glow * 0.38f;
    color += (float3)(1.0f, 0.55f, 0.10f) * glow * 0.17f;

    const float water_mask =
        1.0f - smoothstep(-0.32f, -0.18f, point.y);
    const float perspective =
        1.0f - smoothstep(-1.05f, -0.25f, point.y);
    const float wave_one = native_sin(
        point.x * (8.0f + perspective * 38.0f)
        + time * 2.0f
        + native_sin(point.y * 12.0f));
    const float wave_two = native_sin(
        point.x * (18.0f + perspective * 65.0f)
        - time * 1.3f
        + point.y * 26.0f);
    float water_lines = smoothstep(
        0.80f,
        0.98f,
        wave_one * 0.55f + wave_two * 0.45f);
    water_lines *= water_mask * smoothstep(-1.05f, -0.15f, point.y);
    color += (float3)(0.95f, 0.05f, 0.55f)
        * water_lines
        * (0.65f + perspective * 0.8f);
    color += (float3)(0.15f, 0.65f, 1.0f) * water_lines * 0.18f;

    const float reflection_center =
        native_sin(point.y * 10.0f + time) * 0.025f;
    const float reflection_width = 1.0f - smoothstep(
        0.04f,
        0.58f,
        fabs(point.x + reflection_center));
    const float reflection = reflection_width
        * water_mask
        * smoothstep(-1.0f, -0.18f, point.y);
    const float reflection_lines = smoothstep(
        0.46f,
        1.0f,
        native_sin(
            point.y * 115.0f
            + time * 5.0f
            + native_sin(point.x * 15.0f) * 1.5f));
    color += (float3)(1.0f, 0.22f, 0.55f)
        * reflection
        * reflection_lines
        * 0.42f;
    color += (float3)(1.0f, 0.78f, 0.18f)
        * reflection
        * reflection_lines
        * 0.16f;

    const float2 star_position =
        (point + (float2)(2.0f, 1.3f)) * (float2)(70.0f, 45.0f);
    const int2 star_cell = convert_int2_rtn(floor(star_position));
    const float star_hash = hash_unit(star_cell, seed ^ 0x57A2u, 0u);
    float star = star_hash >= 0.995f ? 1.0f : 0.0f;
    star *= smoothstep(0.05f, 0.75f, point.y);
    star *= saturate(
        0.45f + 0.55f * native_sin(time * 2.0f + star_hash * 20.0f));
    color += (float3)(1.0f, 0.78f, 1.0f) * star;

    const float webgl_frag_y = extent.y - pixel.y;
    const float scanline =
        0.88f + 0.12f * native_sin(webgl_frag_y * pi * 1.15f);
    const float grain = value_noise(
        pixel * 0.75f + (float2)(time * 24.0f),
        seed ^ 0xC27Fu) * 0.035f;
    const float vignette = 1.0f - smoothstep(
        0.18f,
        1.42f,
        vector_length(point * (float2)(0.82f, 0.96f)));
    color *= scanline;
    color += (float3)(grain);
    color *= vignette;

    color = 1.0f - native_exp(-fmax(color, (float3)(0.0f)) * 1.35f);
    color = native_exp2(
        native_log2(fmax(color, (float3)(0.0001f))) * 0.82f);
    return color;
}

TRUEOS_CPP_DEMO_INLINE float3 render_aurora(float2 uv, float time, uint seed)
{
    float2 point = uv;
    point.x *= 1.45f;
    const float seed_phase = static_cast<float>(seed & 255u) * (1.0f / 255.0f);

    float field = 0.0f;
    float weight = 0.55f;
    for (uint octave = 0u; octave < 5u; ++octave) {
        const float octave_f = static_cast<float>(octave);
        const float wave = native_sin(
            point.x * (2.1f + octave_f * 0.73f)
            + native_cos(point.y * (2.7f + octave_f * 0.41f) - time * 0.31f)
            + time * (0.34f + octave_f * 0.08f)
            + seed_phase * 2.0f);
        field += wave * weight;
        point = rotate(point * 1.47f + (float2)(0.17f, -0.11f), 0.39f);
        weight *= 0.58f;
    }

    const float ribbons = native_exp(-9.0f * fabs(uv.y * 0.78f - field * 0.22f));
    const float shimmer =
        0.5f + 0.5f * native_sin(uv.x * 11.0f + field * 3.0f + time * 0.9f);
    float3 color = cosine_palette(
        field * 0.19f + time * 0.025f,
        (float3)(0.45f, 0.48f, 0.55f),
        (float3)(0.45f, 0.42f, 0.40f),
        (float3)(1.00f, 1.17f, 1.31f),
        (float3)(0.08f, 0.31f, 0.58f));
    color *= 0.14f + ribbons * (0.72f + shimmer * 0.42f);
    color += (float3)(0.02f, 0.035f, 0.08f) * (1.0f - saturate(ribbons));
    return color;
}

template <uint MaxIterations>
TRUEOS_CPP_DEMO_INLINE float julia_escape(float2 point, float2 julia_c)
{
    float2 z = point;
    uint iteration = 0u;
    float magnitude_squared = dot(z, z);
    for (; iteration < MaxIterations && magnitude_squared <= 64.0f; ++iteration) {
        z = (float2)(
            z.x * z.x - z.y * z.y,
            2.0f * z.x * z.y) + julia_c;
        magnitude_squared = dot(z, z);
    }

    if (iteration == MaxIterations) {
        return 0.0f;
    }
    const float smooth_iteration =
        static_cast<float>(iteration) + 1.0f
        - native_log2(fmax(1.0f, native_log2(fmax(2.0f, magnitude_squared)))) * 0.5f;
    return saturate(smooth_iteration / static_cast<float>(MaxIterations));
}

TRUEOS_CPP_DEMO_INLINE float3 render_julia(float2 uv, float time, uint seed)
{
    const float seed_phase = static_cast<float>(seed & 1023u) * (1.0f / 1023.0f);
    const float angle = time * 0.105f + seed_phase * 0.8f;
    const float2 julia_c = (float2)(
        -0.745f + native_cos(angle * 1.37f) * 0.055f,
        0.113f + native_sin(angle) * 0.095f);
    const float2 point = rotate(uv * 1.48f, time * 0.035f);
    const float escape = julia_escape<96u>(point, julia_c);
    const float edge = escape > 0.0f
        ? native_exp2(native_log2(escape) * 0.42f)
        : 0.0f;
    float3 color = cosine_palette(
        edge * 1.25f + time * 0.018f,
        (float3)(0.48f),
        (float3)(0.48f),
        (float3)(1.0f, 1.2f, 1.55f),
        (float3)(0.02f, 0.23f, 0.52f));
    const float interior_glow =
        native_exp(-12.0f * fabs(vector_length(point) - 0.64f)) * (1.0f - escape);
    color *= 0.08f + edge * 1.15f;
    color += (float3)(0.18f, 0.05f, 0.32f) * interior_glow;
    return color;
}

TRUEOS_CPP_DEMO_INLINE float sdf_circle(float2 point, float radius)
{
    return vector_length(point) - radius;
}

TRUEOS_CPP_DEMO_INLINE float sdf_box(float2 point, float2 half_extent, float rounding)
{
    const float2 delta = fabs(point) - half_extent + rounding;
    return vector_length(fmax(delta, (float2)(0.0f)))
        + fmin(fmax(delta.x, delta.y), 0.0f) - rounding;
}

TRUEOS_CPP_DEMO_INLINE float sdf_ring(float2 point, float radius, float thickness)
{
    return fabs(vector_length(point) - radius) - thickness;
}

TRUEOS_CPP_DEMO_INLINE float3 render_sdf(float2 uv, float time, uint seed)
{
    const float seed_phase = static_cast<float>(seed & 511u) * (1.0f / 511.0f);
    const float2 spun = rotate(uv, time * 0.31f + seed_phase);
    const float box = sdf_box(
        rotate(spun - (float2)(0.29f, 0.02f), -time * 0.47f),
        (float2)(0.30f, 0.19f),
        0.075f);
    const float circle = sdf_circle(
        spun + (float2)(0.27f, -0.05f),
        0.31f + 0.035f * native_sin(time * 1.3f));
    const float ring = sdf_ring(uv, 0.71f, 0.025f);
    const float merged = fmin(box, circle);
    const float cut = fmax(merged, -sdf_circle(spun, 0.17f));
    const float aa = 2.0f / 720.0f;
    const float shape_alpha = 1.0f - smoothstep(-aa, aa, cut);
    const float ring_alpha = 1.0f - smoothstep(-aa, aa, ring);
    const float edge_glow = native_exp(-18.0f * fabs(cut));

    float3 background = (float3)(0.012f, 0.018f, 0.045f);
    background +=
        (float3)(0.025f, 0.035f, 0.07f) * (1.0f - vector_length(uv) * 0.45f);
    const float3 shape = cosine_palette(
        spun.x * 0.11f + spun.y * 0.17f + time * 0.035f,
        (float3)(0.55f),
        (float3)(0.44f),
        (float3)(1.0f, 1.25f, 1.5f),
        (float3)(0.0f, 0.23f, 0.51f));
    float3 color = mix(background, shape, shape_alpha);
    color += (float3)(0.18f, 0.44f, 0.85f) * edge_glow * 0.38f;
    color += (float3)(0.95f, 0.35f, 0.18f) * ring_alpha;
    return color;
}

TRUEOS_CPP_DEMO_INLINE float3 render_voronoi(float2 uv, float time, uint seed)
{
    const float2 scaled = uv * 4.2f;
    const int2 base = convert_int2_rtn(floor(scaled));
    const float2 cell_local = scaled - floor(scaled);
    float nearest = 100.0f;
    float second = 100.0f;
    float cell_id = 0.0f;

    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            const int2 cell = base + (int2)(x, y);
            float2 feature = (float2)(
                hash_unit(cell, seed, 0u),
                hash_unit(cell, seed, 1u));
            feature = 0.5f
                + 0.42f * native_sin(time * (float2)(0.63f, 0.71f)
                    + feature * 6.28318530718f);
            const float2 delta = (float2)(
                static_cast<float>(x),
                static_cast<float>(y)) + feature - cell_local;
            const float distance_squared = dot(delta, delta);
            if (distance_squared < nearest) {
                second = nearest;
                nearest = distance_squared;
                cell_id = hash_unit(cell, seed, 2u);
            } else if (distance_squared < second) {
                second = distance_squared;
            }
        }
    }

    const float edge =
        saturate((native_sqrt(second) - native_sqrt(nearest)) * 5.0f);
    const float center = native_exp(-6.5f * nearest);
    float3 color = cosine_palette(
        cell_id + time * 0.025f,
        (float3)(0.49f),
        (float3)(0.46f),
        (float3)(1.0f, 1.27f, 1.61f),
        (float3)(0.03f, 0.27f, 0.53f));
    color *= 0.26f + center * 0.92f;
    color += (float3)(0.72f, 0.90f, 1.0f) * (1.0f - edge) * 0.45f;
    return color;
}

TRUEOS_CPP_DEMO_INLINE float hash_cloud(float2 point)
{
    const float value = native_sin(dot(point, (float2)(127.1f, 311.7f))) * 43758.5453f;
    return value - floor(value);
}

TRUEOS_CPP_DEMO_INLINE float cloud_noise(float2 point)
{
    const float2 cell = floor(point);
    const float2 fraction = point - cell;
    const float2 blend = fraction * fraction * (3.0f - 2.0f * fraction);
    const float lower = mix(
        hash_cloud(cell),
        hash_cloud(cell + (float2)(1.0f, 0.0f)),
        blend.x);
    const float upper = mix(
        hash_cloud(cell + (float2)(0.0f, 1.0f)),
        hash_cloud(cell + (float2)(1.0f, 1.0f)),
        blend.x);
    return mix(lower, upper, blend.y);
}

TRUEOS_CPP_DEMO_INLINE float cloud_fbm(float2 point)
{
    float value = 0.0f;
    float amplitude = 0.54f;
    for (uint octave = 0u; octave < 3u; ++octave) {
        value += cloud_noise(point) * amplitude;
        point = point * 2.03f + (float2)(11.7f, 7.1f);
        amplitude *= 0.5f;
    }
    return value * (1.0f / 0.945f);
}

// The WebGPU source generates its 96x48x96 density field with pattern 2.
// This direct UI4 path keeps that high-wisp ridged field analytic, so it needs
// neither a transient 3D allocation nor a simulation warm-up dispatch.  The
// returned value is deliberately a *soft density*, not a cutout alpha: the
// WebGPU reference ray marcher accumulates translucent samples through the
// volume and never turns each formation cell into an opaque painted lobe.
TRUEOS_CPP_DEMO_INLINE float high_wisp_field(float2 point, float time)
{
    using namespace trueos::gpgpu::cloud_high_wisps_preset;

    // Authored preset: seed=19.37, windSpeed=1.95, windDirection=5,
    // turbulence=.84, tearing=1.41, rotation=-.44, amount=.58.
    const float wind_phase = time * 0.13f * wind_speed;
    const float2 wind = (float2)(native_cos(wind_direction), native_sin(wind_direction));
    const float2 drift = wind * wind_phase;
    const float field_warp = cloud_fbm(
        point * (float2)(1.8f, 2.6f) + drift * 0.31f
        + (float2)(formation_seed * 0.017f, formation_seed * 0.031f)) * turbulence;
    const float ribbon_warp = native_sin(point.x * (3.35f + art_curl * 0.42f)
        - point.y * 1.7f + time * 0.58f) * (0.10f + rotation * 0.02f);
    const float2 streak_position = (float2)(
        point.x * 7.0f + field_warp * 2.3f + ribbon_warp,
        point.y * 11.0f - point.x * 1.7f + field_warp * 0.46f)
        + drift * (float2)(0.39f, -0.21f);
    const float streak_noise = cloud_fbm(
        streak_position + (float2)(formation_seed * 0.024f, formation_seed * 0.043f));
    const float ridges = 1.0f - fabs(streak_noise * 2.0f - 1.0f);
    const float threshold = 0.91f - 0.29f * formation_amount;
    // Keep a feathered skirt around the ridges.  The original density texture
    // is linearly sampled and then eroded in the ray marcher, so a binary
    // smoothstep here was the source of the dark bouquet-shaped cutouts.
    const float strands = smoothstep(threshold - 0.075f, threshold + 0.105f, ridges);
    const float band = smoothstep(-0.37f, -0.10f, point.y)
        * (1.0f - smoothstep(0.70f, 1.02f, point.y));
    const float torn = smoothstep(0.18f, 0.94f,
        cloud_noise(point * (float2)(15.0f, 4.0f) + drift * 0.8f));
    const float torn_weight = clamp(tearing * (0.17f / 1.41f), 0.0f, 0.28f);
    return strands * band * mix(1.0f, torn, torn_weight) * art_ribbon;
}

TRUEOS_CPP_DEMO_INLINE float cloud_brush_density(
    float2 normalized,
    float aspect,
    uint16 brush_points_lower,
    uint16 brush_points_upper,
    uint brush_point_count)
{
    float density = 0.0f;
    const uint count = min(brush_point_count, 32u);
    for (uint index = 0u; index < 32u; ++index) {
        if (index >= count) {
            break;
        }
        const uint packed = index < 16u
            ? brush_points_lower[index]
            : brush_points_upper[index - 16u];
        const float2 center = (float2)(
            static_cast<float>(packed & 0xFFFFu),
            static_cast<float>(packed >> 16)) * (1.0f / 65535.0f);
        const float2 delta = (normalized - center) * (float2)(aspect, 1.0f);
        const float radius = 0.125f;
        density = fmax(density, 1.0f - smoothstep(radius * 0.56f, radius, vector_length(delta)));
    }
    return density;
}

TRUEOS_CPP_DEMO_INLINE float3 render_cloud_high_wisps(
    float2 uv,
    float2 normalized,
    float aspect,
    float time,
    uint16 brush_points_lower,
    uint16 brush_points_upper,
    uint brush_point_count)
{
    using namespace trueos::gpgpu::cloud_high_wisps_preset;

    // The browser converts CSS palette values to linear RGB before writing
    // RenderParams.  Keeping the source in sRGB made our shadow too bright,
    // then the opaque mix made it read as black charcoal.  These are the
    // corresponding linear values for the authored JSON colors.
    const float3 sky = (float3)(0.00335f, 0.01850f, 0.05951f);    // #0b2545
    const float3 cloud = (float3)(0.17014f, 0.47932f, 0.58408f);  // #72b8c9
    const float3 shadow = (float3)(0.00857f, 0.04519f, 0.09531f); // #173c58
    const float3 moon = (float3)(1.0f, 0.86316f, 0.38133f);       // #fff0a7

    // UI4's Y origin is top-left, while the WebGPU full-screen ray uses +Y
    // toward the top.  This is the artistic-sky vertical gradient and its
    // gentle side falloff, rather than the old radial blackout vignette.
    const float vertical = saturate(1.0f - normalized.y);
    const float screen_center = 1.0f - fabs(normalized.x * 2.0f - 1.0f);
    const float side_falloff = 0.86f + 0.14f * screen_center * screen_center;
    float3 color = sky * mix(0.62f, 1.18f, vertical) * side_falloff;

    // Fixed moon placement follows the configured negative elevation and
    // azimuth.  It is composed into the sky first, exactly as the reference
    // renderer does, so subsequent cloud transmittance can occlude it.
    const float2 moon_center = (float2)(0.56f, 0.40f);
    const float moon_distance = vector_length(uv - moon_center);
    const float moon_disc = 1.0f - smoothstep(art_moon_size * 0.94f, art_moon_size * 1.02f, moon_distance);
    const float moon_glow = native_exp(-fmax(moon_distance - art_moon_size * 0.9f, 0.0f) * 5.2f)
        * 0.12f * art_moon_glow;
    const float crater = cloud_noise((uv - moon_center) * 17.0f + formation_seed);
    color += moon * (moon_disc * (0.90f + crater * 0.12f) + moon_glow);

    const float star_hash = hash_cloud(floor((uv + (float2)(2.0f)) * (float2)(76.0f, 44.0f)));
    const float stars = smoothstep(0.994f, 0.9994f, star_hash)
        * smoothstep(-0.16f, 0.48f, uv.y);
    color += moon * stars * 0.24f;

    const float base_wisps = high_wisp_field(uv, time);
    const float painted = cloud_brush_density(
        normalized,
        aspect,
        brush_points_lower,
        brush_points_upper,
        brush_point_count);
    const float density = saturate(base_wisps + painted * 0.82f);
    const float edge = high_wisp_field(uv + (float2)(0.018f, -0.011f), time) - base_wisps;
    const float shade = saturate(0.34f + vertical * 0.31f
        + cloud_noise(uv * 3.7f + time * 0.035f) * 0.18f);
    const float banded = floor(shade * static_cast<float>(art_bands - 1u) + 0.5f)
        / static_cast<float>(art_bands - 1u);
    float3 wisp_color = mix(shadow, cloud, banded);
    // Approximate Beer-Lam accumulation from the reference ray marcher.  It
    // is intentionally capped below full opacity for this thin formation;
    // painted input remains visible but cannot collapse into a solid black
    // foreground bouquet.
    const float cloud_alpha = (1.0f - native_exp(-density * (0.92f + art_sculpt * 0.38f))) * 0.72f;
    const float outline = smoothstep(0.013f, 0.082f, fabs(edge)) * art_outline;
    wisp_color = mix(wisp_color, shadow * 0.72f, outline * 0.30f);
    color = color * (1.0f - cloud_alpha) + wisp_color * cloud_alpha;
    color += cloud * density * moon_glow * 0.07f;

    // Match the artistic WebGPU output transfer: its palette is linear until
    // after volume compositing, then exposure/compression/gamma prepares the
    // display RGBA8 surface.  This avoids compensating for the old opaque
    // blend by incorrectly brightening the source palette.
    const float3 exposed = fmax(color * 1.48f, (float3)(0.0f));
    const float3 compressed = exposed / ((float3)(1.0f) + exposed * 0.68f);
    color = native_exp2(native_log2(fmax(compressed, (float3)(0.0001f)))
        * (1.0f / 2.2f));
    const float grain = (hash_cloud(uv * (float2)(600.0f, 410.0f) + time * 4.0f) - 0.5f)
        * (art_grain * 0.034f);
    const float levels = mix(96.0f, 30.0f, art_grain);
    color = floor(clamp(color + (float3)(grain), (float3)(0.0f), (float3)(1.0f)) * levels + 0.5f)
        * (1.0f / levels);
    return color;
}

template <uint Mode>
TRUEOS_CPP_DEMO_INLINE float3 render_mode(float2 uv, float time, uint seed)
{
    if constexpr (Mode == mode_aurora) {
        return render_aurora(uv, time, seed);
    } else if constexpr (Mode == mode_julia) {
        return render_julia(uv, time, seed);
    } else if constexpr (Mode == mode_sdf) {
        return render_sdf(uv, time, seed);
    } else if constexpr (Mode == mode_cloud_high_wisps) {
        return render_cloud_high_wisps(
            uv, uv * 0.5f + 0.5f, 1.0f, time, (uint16)(0u), (uint16)(0u), 0u);
    } else {
        static_assert(Mode == mode_voronoi, "unsupported C++ demo mode");
        return render_voronoi(uv, time, seed);
    }
}

TRUEOS_CPP_DEMO_INLINE float3 render_selected(uint mode, float2 uv, float time, uint seed)
{
    switch (mode) {
        case mode_aurora:
            return render_mode<mode_aurora>(uv, time, seed);
        case mode_julia:
            return render_mode<mode_julia>(uv, time, seed);
        case mode_sdf:
            return render_mode<mode_sdf>(uv, time, seed);
        case mode_voronoi:
            return render_mode<mode_voronoi>(uv, time, seed);
        case mode_cloud_high_wisps:
            return render_mode<mode_cloud_high_wisps>(uv, time, seed);
        default:
            return (float3)(0.0f);
    }
}

TRUEOS_CPP_DEMO_INLINE float3 render_gallery(float2 normalized, float time, uint seed)
{
    const uint column = normalized.x >= 0.5f ? 1u : 0u;
    const uint row = normalized.y >= 0.5f ? 1u : 0u;
    const uint mode = 1u + row * 2u + column;
    const float2 panel_position = normalized * 2.0f;
    const float2 panel_fraction = panel_position - floor(panel_position);
    const float2 panel_uv = panel_fraction * 2.0f - 1.0f;
    float3 color = render_selected(mode, panel_uv, time, seed + mode * 101u);

    const float2 edge_distance = fabs(panel_fraction - 0.5f);
    const float panel_edge = fmax(edge_distance.x, edge_distance.y);
    const float border = smoothstep(0.465f, 0.495f, panel_edge);
    color = mix(color, (float3)(0.72f, 0.84f, 1.0f), border * 0.72f);
    return color;
}

} // namespace trueos::gpgpu::cpp_demo

#undef TRUEOS_CPP_DEMO_INLINE

TRUEOS_REQD_SUB_GROUP_SIZE_16
__kernel void cpp_demo_rgba8(
    __global uint *dst_rgba,
    uint dst_pitch_bytes,
    uint dst_width,
    uint dst_height,
    uint rect_x,
    uint rect_y,
    uint rect_width,
    uint rect_height,
    float time_seconds,
    uint demo_mode,
    uint seed,
    uint flags,
    uint16 brush_points_lower,
    uint16 brush_points_upper,
    uint brush_point_count)
{
    using namespace trueos::gpgpu::cpp_demo;

    const uint local_x = static_cast<uint>(get_global_id(0));
    const uint local_y = static_cast<uint>(get_global_id(1));
    if (local_x >= rect_width || local_y >= rect_height
        || rect_x >= dst_width || rect_y >= dst_height
        || local_x >= dst_width - rect_x || local_y >= dst_height - rect_y) {
        return;
    }

    const uint x = rect_x + local_x;
    const uint y = rect_y + local_y;
    const float2 normalized = (float2)(
        (static_cast<float>(local_x) + 0.5f) / static_cast<float>(rect_width),
        (static_cast<float>(local_y) + 0.5f) / static_cast<float>(rect_height));
    const float aspect =
        static_cast<float>(rect_width) / fmax(1.0f, static_cast<float>(rect_height));
    const float2 uv = (normalized * 2.0f - 1.0f) * (float2)(aspect, 1.0f);
    const uint bounded_mode = demo_mode < mode_count ? demo_mode : mode_gallery;

    float3 color;
    if (bounded_mode == mode_gallery) {
        color = render_gallery(normalized, time_seconds, seed);
    } else if (bounded_mode == mode_retro_sun) {
        color = render_retro_sun(
            uv,
            (float2)(
                static_cast<float>(local_x) + 0.5f,
                static_cast<float>(local_y) + 0.5f),
            (float2)(
                static_cast<float>(rect_width),
                static_cast<float>(rect_height)),
            time_seconds,
            seed);
    } else if (bounded_mode == mode_cloud_high_wisps) {
        color = render_cloud_high_wisps(
            uv,
            normalized,
            aspect,
            time_seconds,
            brush_points_lower,
            brush_points_upper,
            brush_point_count);
    } else {
        color = render_selected(bounded_mode, uv, time_seconds, seed);
    }
    // The generic C++ suite's post-vignette is useful for its synthetic modes,
    // but the cloud reference already owns its sky edge treatment.  Applying
    // it here was a second, much harsher vignette and caused the black lobes
    // seen around the cloud view.
    if ((flags & 1u) != 0u && bounded_mode != mode_cloud_high_wisps) {
        const float vignette =
            saturate(1.16f - 0.34f * dot(normalized * 2.0f - 1.0f,
                                        normalized * 2.0f - 1.0f));
        color *= vignette;
    }

    const uint pitch_pixels =
        dst_pitch_bytes / trueos::gpgpu::rgba8_bytes_per_pixel;
    dst_rgba[y * pitch_pixels + x] = pack_opaque(color);
}
