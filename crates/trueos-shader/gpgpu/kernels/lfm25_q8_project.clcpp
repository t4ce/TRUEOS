// Fixed LFM2.5-350M Q8_0 projection for the TRUEOS C++/IGC lane.
//
// This is deliberately not a generic quantized-matrix framework. The admitted
// shapes are exactly the Q8 matrices in the sealed LFM2.5-350M native image:
// 1024-wide operator/attention/FFN-up/vocabulary projections and the
// 4608-wide FFN-down projection. Both weights and activations use the GGML
// Q8_0 block layout (binary16 scale followed by 32 signed bytes).
//
// One SIMD16 work-group computes sixteen output rows. Each lane owns one row,
// which preserves the pinned eight-accumulator dot order without SLM, scratch,
// atomics, or a cross-work-item reduction.

#include "include/trueos_clcpp.hpp"

namespace trueos::gpgpu::lfm25 {

inline constexpr uint hidden = 1024u;
inline constexpr uint ffn = 4608u;
inline constexpr uint vocabulary = 65536u;
inline constexpr uint q8_values = 32u;
inline constexpr uint q8_bytes = 34u;

__attribute__((always_inline)) inline bool admitted_shape(
    uint columns,
    uint rows)
{
    if (columns == hidden) {
        return rows == 512u
            || rows == hidden
            || rows == 3072u
            || rows == ffn
            || rows == vocabulary;
    }
    return columns == ffn && rows == hidden;
}

__attribute__((always_inline)) inline float q8_scale(
    __global const uint *blocks,
    uint offset)
{
    const uint low_word = blocks[offset >> 2u];
    const uint low_shift = (offset & 3u) << 3u;
    const uchar low = static_cast<uchar>((low_word >> low_shift) & 0xffu);
    const uint high_offset = offset + 1u;
    const uint high_word = blocks[high_offset >> 2u];
    const uint high_shift = (high_offset & 3u) << 3u;
    const uchar high = static_cast<uchar>((high_word >> high_shift) & 0xffu);
    const ushort bits =
        static_cast<ushort>(low)
        | static_cast<ushort>(
            static_cast<ushort>(high) << 8u);
    return convert_float(as_half(bits));
}

__attribute__((always_inline)) inline int q8_value(
    __global const uint *blocks,
    uint offset)
{
    const uint word = blocks[offset >> 2u];
    const uint shift = (offset & 3u) << 3u;
    return static_cast<int>(
        as_char(static_cast<uchar>((word >> shift) & 0xffu)));
}

__attribute__((always_inline)) inline int saturated_pair(
    __global const uint *weights,
    __global const uint *activation,
    uint weight_offset,
    uint activation_offset)
{
    const int sum =
        q8_value(weights, weight_offset)
            * q8_value(activation, activation_offset)
        + q8_value(weights, weight_offset + 1u)
            * q8_value(activation, activation_offset + 1u);
    return clamp(sum, -32768, 32767);
}

} // namespace trueos::gpgpu::lfm25

TRUEOS_REQD_SUB_GROUP_SIZE_16
__kernel void lfm25_q8_project(
    __global const uint *weights,
    __global const uint *activation,
    __global float *output,
    uint weight_offset,
    uint columns,
    uint rows)
{
    using namespace trueos::gpgpu::lfm25;

    const uint row = static_cast<uint>(get_global_id(0));
    if (!admitted_shape(columns, rows) || row >= rows) {
        return;
    }

    const uint blocks_per_row = columns / q8_values;
    const uint row_offset =
        weight_offset + row * blocks_per_row * q8_bytes;
    float sum0 = 0.0f;
    float sum1 = 0.0f;
    float sum2 = 0.0f;
    float sum3 = 0.0f;
    float sum4 = 0.0f;
    float sum5 = 0.0f;
    float sum6 = 0.0f;
    float sum7 = 0.0f;

    for (uint block = 0u; block < blocks_per_row; ++block) {
        const uint weight_block = row_offset + block * q8_bytes;
        const uint activation_block = block * q8_bytes;
        const float scale =
            q8_scale(weights, weight_block)
            * q8_scale(activation, activation_block);

        const int dot0 =
            saturated_pair(weights, activation, weight_block + 2u, activation_block + 2u)
            + saturated_pair(weights, activation, weight_block + 4u, activation_block + 4u);
        const int dot1 =
            saturated_pair(weights, activation, weight_block + 6u, activation_block + 6u)
            + saturated_pair(weights, activation, weight_block + 8u, activation_block + 8u);
        const int dot2 =
            saturated_pair(weights, activation, weight_block + 10u, activation_block + 10u)
            + saturated_pair(weights, activation, weight_block + 12u, activation_block + 12u);
        const int dot3 =
            saturated_pair(weights, activation, weight_block + 14u, activation_block + 14u)
            + saturated_pair(weights, activation, weight_block + 16u, activation_block + 16u);
        const int dot4 =
            saturated_pair(weights, activation, weight_block + 18u, activation_block + 18u)
            + saturated_pair(weights, activation, weight_block + 20u, activation_block + 20u);
        const int dot5 =
            saturated_pair(weights, activation, weight_block + 22u, activation_block + 22u)
            + saturated_pair(weights, activation, weight_block + 24u, activation_block + 24u);
        const int dot6 =
            saturated_pair(weights, activation, weight_block + 26u, activation_block + 26u)
            + saturated_pair(weights, activation, weight_block + 28u, activation_block + 28u);
        const int dot7 =
            saturated_pair(weights, activation, weight_block + 30u, activation_block + 30u)
            + saturated_pair(weights, activation, weight_block + 32u, activation_block + 32u);

        sum0 = fma(scale, static_cast<float>(dot0), sum0);
        sum1 = fma(scale, static_cast<float>(dot1), sum1);
        sum2 = fma(scale, static_cast<float>(dot2), sum2);
        sum3 = fma(scale, static_cast<float>(dot3), sum3);
        sum4 = fma(scale, static_cast<float>(dot4), sum4);
        sum5 = fma(scale, static_cast<float>(dot5), sum5);
        sum6 = fma(scale, static_cast<float>(dot6), sum6);
        sum7 = fma(scale, static_cast<float>(dot7), sum7);
    }

    const float low0 = sum0 + sum4;
    const float low1 = sum1 + sum5;
    const float low2 = sum2 + sum6;
    const float low3 = sum3 + sum7;
    output[row] = (low0 + low2) + (low1 + low3);
}
