// Helio retained-geometry transform/compaction pass for TRUEOS Xe-LP.
// Canonical source language: C++ for OpenCL.
//
// The pass expands one compact, positive-scale quaternion transform into
// Helio's 208-byte GpuInstanceData ABI, scatters instance IDs into fixed
// per-draw compact slices, and writes WGPU's exact 20-byte
// DrawIndexedIndirectArgs records. Its alternate expanded modes additionally
// project each retained mesh's 24 immutable PosNormal vertices into a compact,
// GPU-authored Float3 NDC stream. A storage-free pass-through vertex shader can
// consume that stream with a repeated immutable cube-index buffer.
//
// The command encoder invokes this entrypoint twice. PREPARE publishes the
// exact indirect records, then an ordered TRANSFORM dispatch fans rows across
// all available SIMD16 groups. Keeping both modes in one artifact avoids a
// second instruction image without imposing a single-workgroup bottleneck.

enum : uint {
    HELIO_TRANSFORM_WORDS = 16,
    HELIO_DRAW_TEMPLATE_WORDS = 6,
    HELIO_INSTANCE_WORDS = 52,
    HELIO_INDIRECT_WORDS = 5,
    HELIO_CAMERA_VIEW_PROJ_WORD = 32,
    HELIO_SOURCE_VERTEX_WORDS = 6,
    HELIO_VERTICES_PER_MESH = 24,
    HELIO_INDICES_PER_MESH = 36,
    HELIO_EXPANDED_POSITION_WORDS = 3,
    HELIO_DISABLED_DRAW_GROUP = 0xFFFFFFFFu,
    HELIO_MODE_PREPARE = 0u,
    HELIO_MODE_TRANSFORM = 1u,
    HELIO_MODE_PREPARE_EXPANDED = 2u,
    HELIO_MODE_TRANSFORM_EXPANDED = 3u,
};

static_assert(HELIO_CAMERA_VIEW_PROJ_WORD * sizeof(uint) == 128u,
    "GpuCameraUniforms.view_proj ABI changed");
static_assert(HELIO_SOURCE_VERTEX_WORDS * sizeof(uint) == 24u,
    "PosNormal vertex stride changed");
static_assert(HELIO_EXPANDED_POSITION_WORDS * sizeof(uint) == 12u,
    "Float3 expanded-position stride changed");

static inline void helio_store_float(__global uint *dst, uint word, float value)
{
    dst[word] = as_uint(value);
}

__attribute__((intel_reqd_sub_group_size(16)))
__kernel void helio_retained_transform(
    __global const uint *transforms,
    __global const uint *draw_templates,
    __global uint *instances,
    __global uint *compacted_indices,
    __global uint *indirect_args,
    uint row_count,
    uint draw_count,
    uint mode,
    __global const uint *camera,
    __global const uint *source_vertices,
    __global uint *expanded_positions)
{
    uint item = get_global_id(0);
    if (mode == HELIO_MODE_PREPARE || mode == HELIO_MODE_PREPARE_EXPANDED) {
        if (item >= draw_count) {
            return;
        }
        // Draw template words:
        //   index_count, first_index, base_vertex bits, first_instance,
        //   compacted capacity, packed mesh/material IDs.
        uint src = item * HELIO_DRAW_TEMPLATE_WORDS;
        uint dst = item * HELIO_INDIRECT_WORDS;
        if (mode == HELIO_MODE_PREPARE_EXPANDED) {
            // One expanded indexed draw per retained group. The companion
            // immutable index buffer repeats the local 36-index cube pattern
            // for every global compact slot, already biased by slot * 24.
            uint capacity = draw_templates[src + 4u];
            uint first_slot = draw_templates[src + 3u];
            indirect_args[dst + 0u] = capacity * HELIO_INDICES_PER_MESH;
            indirect_args[dst + 1u] = capacity != 0u ? 1u : 0u;
            indirect_args[dst + 2u] = first_slot * HELIO_INDICES_PER_MESH;
            indirect_args[dst + 3u] = 0u;
            indirect_args[dst + 4u] = 0u;
        } else {
            indirect_args[dst + 0u] = draw_templates[src + 0u];
            indirect_args[dst + 1u] = draw_templates[src + 4u];
            indirect_args[dst + 2u] = draw_templates[src + 1u];
            indirect_args[dst + 3u] = draw_templates[src + 2u];
            indirect_args[dst + 4u] = draw_templates[src + 3u];
        }
        return;
    }
    bool expand_positions = mode == HELIO_MODE_TRANSFORM_EXPANDED;
    if ((mode != HELIO_MODE_TRANSFORM && !expand_positions) || item >= row_count) {
        return;
    }

    // Transform words:
    //   center.xyz, scale.xyz, rotation quaternion.xyzw, local_radius,
    //   previous_center.xyz, draw_group, packed slot/flags. The high 16 bits
    //   carry a producer-assigned compact slot and the low 16 bits carry
    //   instance flags. Mesh/material IDs remain in the immutable template.
    uint row = item;
    uint src = row * HELIO_TRANSFORM_WORDS;
    uint draw = transforms[src + 14u];
    if (draw == HELIO_DISABLED_DRAW_GROUP || draw >= draw_count) {
        return;
    }

    float tx = as_float(transforms[src + 0u]);
    float ty = as_float(transforms[src + 1u]);
    float tz = as_float(transforms[src + 2u]);
    float sx = as_float(transforms[src + 3u]);
    float sy = as_float(transforms[src + 4u]);
    float sz = as_float(transforms[src + 5u]);
    float qx = as_float(transforms[src + 6u]);
    float qy = as_float(transforms[src + 7u]);
    float qz = as_float(transforms[src + 8u]);
    float qw = as_float(transforms[src + 9u]);
    float local_radius = as_float(transforms[src + 10u]);
    float ptx = as_float(transforms[src + 11u]);
    float pty = as_float(transforms[src + 12u]);
    float ptz = as_float(transforms[src + 13u]);

    // The initial retained path excludes mirrored and singular transforms.
    // Besides keeping winding fixed, this makes the inverse-scale normal
    // matrix finite without a slow generic inverse.
    float quaternion_length_squared = qx * qx + qy * qy + qz * qz + qw * qw;
    if (!(isfinite(tx) && isfinite(ty) && isfinite(tz)
        && isfinite(ptx) && isfinite(pty) && isfinite(ptz)
        && isfinite(sx) && isfinite(sy) && isfinite(sz)
        && isfinite(qx) && isfinite(qy) && isfinite(qz) && isfinite(qw)
        && isfinite(local_radius) && isfinite(quaternion_length_squared))
        || sx <= 0.0f || sy <= 0.0f || sz <= 0.0f
        || local_radius < 0.0f || quaternion_length_squared <= 1.0e-12f) {
        return;
    }

    uint draw_src = draw * HELIO_DRAW_TEMPLATE_WORDS;
    uint capacity = draw_templates[draw_src + 4u];
    uint packed_slot_flags = transforms[src + 15u];
    uint slot = packed_slot_flags >> 16;
    if (slot >= capacity) {
        return;
    }

    float inverse_quaternion_length = rsqrt(quaternion_length_squared);
    qx *= inverse_quaternion_length;
    qy *= inverse_quaternion_length;
    qz *= inverse_quaternion_length;
    qw *= inverse_quaternion_length;
    float xx = qx * qx;
    float yy = qy * qy;
    float zz = qz * qz;
    float xy = qx * qy;
    float xz = qx * qz;
    float yz = qy * qz;
    float xw = qx * qw;
    float yw = qy * qw;
    float zw = qz * qw;
    float r00 = 1.0f - 2.0f * (yy + zz);
    float r01 = 2.0f * (xy - zw);
    float r02 = 2.0f * (xz + yw);
    float r10 = 2.0f * (xy + zw);
    float r11 = 1.0f - 2.0f * (xx + zz);
    float r12 = 2.0f * (yz - xw);
    float r20 = 2.0f * (xz - yw);
    float r21 = 2.0f * (yz + xw);
    float r22 = 1.0f - 2.0f * (xx + yy);
    uint dst = row * HELIO_INSTANCE_WORDS;

    // Column-major model matrix, byte-for-byte compatible with WGSL mat4.
        helio_store_float(instances, dst + 0u, r00 * sx);
        helio_store_float(instances, dst + 1u, r10 * sx);
        helio_store_float(instances, dst + 2u, r20 * sx);
        helio_store_float(instances, dst + 3u, 0.0f);
        helio_store_float(instances, dst + 4u, r01 * sy);
        helio_store_float(instances, dst + 5u, r11 * sy);
        helio_store_float(instances, dst + 6u, r21 * sy);
        helio_store_float(instances, dst + 7u, 0.0f);
        helio_store_float(instances, dst + 8u, r02 * sz);
        helio_store_float(instances, dst + 9u, r12 * sz);
        helio_store_float(instances, dst + 10u, r22 * sz);
        helio_store_float(instances, dst + 11u, 0.0f);
        helio_store_float(instances, dst + 12u, tx);
        helio_store_float(instances, dst + 13u, ty);
        helio_store_float(instances, dst + 14u, tz);
        helio_store_float(instances, dst + 15u, 1.0f);

        // Three padded vec4 columns expected by Helio's forward vertex shader.
        helio_store_float(instances, dst + 16u, r00 / sx);
        helio_store_float(instances, dst + 17u, r10 / sx);
        helio_store_float(instances, dst + 18u, r20 / sx);
        helio_store_float(instances, dst + 19u, 0.0f);
        helio_store_float(instances, dst + 20u, r01 / sy);
        helio_store_float(instances, dst + 21u, r11 / sy);
        helio_store_float(instances, dst + 22u, r21 / sy);
        helio_store_float(instances, dst + 23u, 0.0f);
        helio_store_float(instances, dst + 24u, r02 / sz);
        helio_store_float(instances, dst + 25u, r12 / sz);
        helio_store_float(instances, dst + 26u, r22 / sz);
        helio_store_float(instances, dst + 27u, 0.0f);

        float max_scale = fmax(sx, fmax(sy, sz));
        helio_store_float(instances, dst + 28u, tx);
        helio_store_float(instances, dst + 29u, ty);
        helio_store_float(instances, dst + 30u, tz);
        helio_store_float(instances, dst + 31u, local_radius * max_scale);

        // Previous model uses the same rotation/scale and previous center.
        for (uint word = 0u; word < 12u; ++word) {
            instances[dst + 32u + word] = instances[dst + word];
        }
        helio_store_float(instances, dst + 44u, ptx);
        helio_store_float(instances, dst + 45u, pty);
        helio_store_float(instances, dst + 46u, ptz);
        helio_store_float(instances, dst + 47u, 1.0f);

        uint packed_mesh_material = draw_templates[draw_src + 5u];
        instances[dst + 48u] = packed_mesh_material & 0xFFFFu;
        instances[dst + 49u] = packed_mesh_material >> 16;
        instances[dst + 50u] = packed_slot_flags & 0xFFFFu;
        instances[dst + 51u] = 0xFFFFFFFFu;

        uint first_instance = draw_templates[draw_src + 3u];
        uint compacted_slot = first_instance + slot;
        compacted_indices[compacted_slot] = row;

        if (!expand_positions) {
            return;
        }

        // GpuCameraUniforms is column-major; view_proj begins at byte 128.
        uint vp = HELIO_CAMERA_VIEW_PROJ_WORD;
        float vp00 = as_float(camera[vp + 0u]);
        float vp10 = as_float(camera[vp + 1u]);
        float vp20 = as_float(camera[vp + 2u]);
        float vp30 = as_float(camera[vp + 3u]);
        float vp01 = as_float(camera[vp + 4u]);
        float vp11 = as_float(camera[vp + 5u]);
        float vp21 = as_float(camera[vp + 6u]);
        float vp31 = as_float(camera[vp + 7u]);
        float vp02 = as_float(camera[vp + 8u]);
        float vp12 = as_float(camera[vp + 9u]);
        float vp22 = as_float(camera[vp + 10u]);
        float vp32 = as_float(camera[vp + 11u]);
        float vp03 = as_float(camera[vp + 12u]);
        float vp13 = as_float(camera[vp + 13u]);
        float vp23 = as_float(camera[vp + 14u]);
        float vp33 = as_float(camera[vp + 15u]);

        uint mesh = draw_templates[draw_src + 5u] & 0xFFFFu;
        uint mesh_vertex = mesh * HELIO_VERTICES_PER_MESH;
        uint expanded_vertex = compacted_slot * HELIO_VERTICES_PER_MESH;
        for (uint vertex = 0u; vertex < HELIO_VERTICES_PER_MESH; ++vertex) {
            uint source = (mesh_vertex + vertex) * HELIO_SOURCE_VERTEX_WORDS;
            float lx = as_float(source_vertices[source + 0u]);
            float ly = as_float(source_vertices[source + 1u]);
            float lz = as_float(source_vertices[source + 2u]);

            float wx = r00 * sx * lx + r01 * sy * ly + r02 * sz * lz + tx;
            float wy = r10 * sx * lx + r11 * sy * ly + r12 * sz * lz + ty;
            float wz = r20 * sx * lx + r21 * sy * ly + r22 * sz * lz + tz;
            float cx = vp00 * wx + vp01 * wy + vp02 * wz + vp03;
            float cy = vp10 * wx + vp11 * wy + vp12 * wz + vp13;
            float cz = vp20 * wx + vp21 * wy + vp22 * wz + vp23;
            float cw = vp30 * wx + vp31 * wy + vp32 * wz + vp33;

            uint output = (expanded_vertex + vertex) * HELIO_EXPANDED_POSITION_WORDS;
            if (isfinite(cx) && isfinite(cy) && isfinite(cz) && isfinite(cw)
                && cw > 1.0e-8f) {
                float inverse_w = 1.0f / cw;
                helio_store_float(expanded_positions, output + 0u, cx * inverse_w);
                helio_store_float(expanded_positions, output + 1u, cy * inverse_w);
                helio_store_float(expanded_positions, output + 2u, cz * inverse_w);
            } else {
                // Keep invalid/behind-camera vertices finite and clipped.
                helio_store_float(expanded_positions, output + 0u, 2.0f);
                helio_store_float(expanded_positions, output + 1u, 2.0f);
                helio_store_float(expanded_positions, output + 2u, 0.999f);
            }
        }
}
